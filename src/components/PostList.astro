---
// 아티클 목록(홈)과 블로그 목록이 함께 쓰는 카드 목록.
import Icon from './Icon.astro';
import { cover } from '../data/cover';
import { t, formatDateFor, DEFAULT_LANG, type Lang } from '../i18n/ui';
import { seoulISO } from '../data/site';

export interface ListItem {
  href: string;
  // 읽은 정도를 찾을 때 쓰는 이름 (글 페이지의 storageKey와 같아야 한다)
  key: string;
  title: string;
  description: string;
  minutes: number;
  // 대표 이미지. 이미지를 쓰는 목록에서 비워 두면 무늬 칸이 들어간다
  image?: string;
  chip?: string;
  time?: { text: string; moment?: string; anytime?: boolean };
  date?: Date;
  // 거르기 · 찾기에 쓰는 값
  category?: string;
  hay?: string;
}

interface Props {
  items: ListItem[];
  // 카드 위에 이미지 칸을 둘지
  images?: boolean;
  // 첫 글을 가로로 크게 보여 줄지
  lead?: boolean;
  emptyText?: string;
  lang?: Lang;
}
const { items, images = false, lead = false, lang = DEFAULT_LANG } = Astro.props;
const tr = t(lang);
const emptyText = Astro.props.emptyText ?? tr.list.empty;
---
<ol class:list={['cards', images && 'has-images']} data-rows>
  {items.map((it, i) => (
    <li
      class:list={['card', 'row', lead && i === 0 && 'is-lead']}
      data-category={it.category}
      data-hay={it.hay}
      data-key={it.key}
    >
      {images && (
        it.image ? (
          <div class="card-img">
            <img src={it.image} alt="" width="800" height="500" loading={i < 4 ? 'eager' : 'lazy'} decoding="async" />
          </div>
        ) : (
          <div class="card-img is-cover" aria-hidden="true" set:html={cover(it.key, it.title, it.hay ?? '')} />
        )
      )}
      <div class="card-body">
        <h3><a href={it.href}>{it.title}</a></h3>
        <p class="card-desc">{it.description}</p>
        <div class="card-foot tabular">
          <div class="card-meta">
            {it.chip && <span class="chip">{it.chip}</span>}
            {it.time && (
              <span class="card-time">
                <span class:list={['time-mark', it.time.anytime && 'anytime']}>{it.time.text}</span>
                {it.time.moment && <> <span class="card-moment">{it.time.moment}</span></>}
              </span>
            )}
            {it.date && <time class="card-time" datetime={seoulISO(it.date)}>{formatDateFor(lang, it.date)}</time>}
          </div>
          <div class="card-sub">
            <span class="card-min">{tr.post.minutes(it.minutes)}</span>
            <span class="row-state" data-state hidden>
              <span class="state-done"><Icon name="check" /> {tr.list.done}</span>
              <span class="state-flag"><Icon name="flag" /> <span set:html={tr.list.partial('<span data-pct></span>')} /></span>
            </span>
            <span class="card-go" aria-hidden="true"><Icon name="arrow-right" /></span>
          </div>
        </div>
      </div>
    </li>
  ))}
</ol>
<p class="rows-empty" data-empty hidden>{emptyText}</p>

<script>
  // 글 페이지가 이 브라우저에 남긴 읽은 정도를 카드에 표시한다
  let progress: Record<string, number> = {};
  try { progress = JSON.parse(localStorage.getItem('mgs:progress') || '{}'); } catch {}
  document.querySelectorAll<HTMLElement>('[data-rows] .row').forEach((row) => {
    const p = progress[row.dataset.key ?? ''];
    if (!p || p < 0.05) return;
    const state = row.querySelector<HTMLElement>('[data-state]');
    if (!state) return;
    state.hidden = false;
    state.classList.add(p >= 0.9 ? 'is-done' : 'is-partial');
    const pct = state.querySelector('[data-pct]');
    if (pct) pct.textContent = String(Math.round(p * 100));
  });
</script>

<style>
  .cards {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1.25rem;
  }
  .card {
    position: relative;
    display: flex;
    flex-direction: column;
    border: 1px solid var(--line);
    border-radius: var(--radius-card);
    background: var(--surface);
    box-shadow: var(--shadow-sm);
    overflow: hidden;
    transition:
      transform 220ms var(--ease-out),
      box-shadow 220ms var(--ease-out),
      border-color 150ms ease;
  }
  .card:focus-within { border-color: var(--line-strong); }
  .card:has(h3 a:focus-visible) { outline: 2px solid var(--accent); outline-offset: 2px; }
  .card h3 a:focus-visible { outline: none; }

  .card-img { aspect-ratio: 16 / 10; background: var(--sunk); overflow: hidden; border-bottom: 1px solid var(--line); }
  .card-img img { width: 100%; height: 100%; object-fit: cover; transition: transform 400ms var(--ease-out); }
  .card-img.is-cover { background: var(--frame); }
  .card-img.is-cover :global(svg) { display: block; width: 100%; height: 100%; transition: transform 400ms var(--ease-out); }

  .card-body { flex: 1; display: flex; flex-direction: column; padding: 1.5rem 1.5rem 1.25rem; }
  .card h3 {
    font-size: var(--text-lg);
    font-weight: 700;
    line-height: 1.5;
    letter-spacing: -0.025em;
    color: var(--ink);
  }
  .has-images .card h3 { display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden; }
  .card h3 a { text-decoration: none; }
  .card h3 a::after { content: ''; position: absolute; inset: 0; border-radius: inherit; }
  .card-desc {
    flex: 1;
    margin-top: 0.5rem;
    font-size: var(--text-ui);
    line-height: 1.7;
    color: var(--muted);
  }
  .has-images .card-desc { display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
  .card-foot {
    display: flex;
    flex-direction: column;
    margin-top: 1.25rem;
    padding-top: 1rem;
    border-top: 1px solid var(--line);
    font-size: var(--text-sm);
    color: var(--muted);
  }
  /* 영어 카테고리 이름처럼 긴 글자는 좁은 화면에서 다음 줄로 넘긴다 */
  .card-meta { display: flex; flex-wrap: wrap; align-items: center; gap: 0.375rem 0.625rem; min-width: 0; }
  .card-sub { display: flex; align-items: center; gap: 0.875rem; min-height: 2rem; margin-top: 0.625rem; }
  .card-time, .card-min { white-space: nowrap; }
  .card-moment { color: var(--muted); }
  .card-go {
    margin-left: auto;
    display: grid;
    place-items: center;
    width: 2rem; height: 2rem;
    border-radius: 999px;
    background: var(--sunk);
    color: var(--ink-soft);
    transition: background-color 150ms ease, color 150ms ease, transform 220ms var(--ease-out);
  }
  .card-go :global(.icon) { width: 1rem; height: 1rem; }

  .row-state > span { display: none; align-items: center; gap: 0.3rem; font-weight: 600; }
  .row-state :global(.icon) { width: 1rem; height: 1rem; }
  .row-state.is-done .state-done { display: inline-flex; color: var(--accent-strong); }
  .row-state.is-partial .state-flag { display: inline-flex; color: var(--ink-soft); }
  .rows-empty { padding: 3rem 0; text-align: center; color: var(--muted); }

  /* 첫 글을 가로로 크게 */
  .card.is-lead { grid-column: 1 / -1; display: grid; grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr); }
  .card.is-lead .card-img { aspect-ratio: auto; min-height: 20rem; border-bottom: 0; border-right: 1px solid var(--line); }
  .card.is-lead .card-body { justify-content: center; padding: clamp(1.75rem, 4vw, 3rem); }
  .card.is-lead h3 { font-size: var(--text-2xl); line-height: 1.4; letter-spacing: -0.035em; }
  .card.is-lead .card-desc { flex: none; margin-top: 0.875rem; -webkit-line-clamp: 4; }

  @media (hover: hover) and (pointer: fine) {
    .card:hover { border-color: var(--line-strong); box-shadow: var(--shadow-md); }
    .card:hover .card-go { background: var(--accent); color: #fff; }
  }
  @media (hover: hover) and (pointer: fine) and (prefers-reduced-motion: no-preference) {
    .card:hover { transform: translateY(-3px); }
    .card:hover .card-go { transform: translateX(2px); }
    .card:hover .card-img img, .card:hover .card-img.is-cover :global(svg) { transform: scale(1.03); }
  }
  @media (prefers-reduced-motion: no-preference) {
    .card:active { transform: scale(0.99); transition-duration: 120ms; }
  }

  @media (max-width: 1024px) {
    .cards { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .card.is-lead .card-img { min-height: 16rem; }
  }
  @media (max-width: 720px) {
    .card.is-lead { display: flex; }
    .card.is-lead .card-img { aspect-ratio: 16 / 10; min-height: 0; border-right: 0; border-bottom: 1px solid var(--line); }
    .card.is-lead .card-body { padding: 1.25rem 1.25rem 1rem; }
    .card.is-lead h3 { font-size: var(--text-xl); }
  }
  @media (max-width: 640px) {
    .cards { grid-template-columns: 1fr; gap: 0.875rem; }
    .card-body { padding: 1.25rem 1.25rem 1rem; }
  }
</style>
