<style>
  .scene { display: block; width: 100%; height: 100%; overflow: visible; }
  .scene :global(*) { vector-effect: non-scaling-stroke; }
  .s-line, .s-floor, .s-faint, .s-alert, .s-accent, .s-wire, .s-arrow, .s-check-mark, .s-fold {
    fill: none;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .s-line { stroke: var(--ink); stroke-width: 2; }
  .s-floor { stroke: var(--line-strong); stroke-width: 2; }
  /* 뇌 주름 */
  .s-fold { fill: none; stroke: var(--accent); stroke-width: 1.75; stroke-linecap: round; opacity: 0.55; }
  .s-faint { stroke: var(--line-strong); stroke-width: 2; stroke-dasharray: 1 6; }
  .s-soft { fill: var(--accent-soft); }
  .s-soft-area { fill: var(--accent-soft); stroke: none; }
  .s-fill-paper { fill: var(--surface); }
  .s-alert { stroke: var(--danger); stroke-width: 2.25; }
  .s-alert-fill { fill: var(--danger-soft); stroke: var(--danger); stroke-width: 2; stroke-linejoin: round; }
  .s-accent { stroke: var(--accent); stroke-width: 3; }
  .s-accent-fill { fill: var(--accent); }
  .s-wire { stroke: var(--accent); stroke-width: 2.25; stroke-dasharray: 6 6; }
  .s-heart { fill: var(--danger-soft); stroke: var(--danger); stroke-width: 2; }
  .s-check-mark { stroke: #fff; stroke-width: 2.5; }
  .s-check-ink { stroke: var(--accent); stroke-width: 4; }
  .s-soft-leaf { fill: var(--accent-soft); stroke: var(--accent); stroke-width: 2; stroke-linejoin: round; }
  .s-faint-dot { fill: var(--line-strong); }
  /* 장: 테두리가 있는 굵은 관 */
  .s-tube-edge { fill: none; stroke: var(--ink); stroke-width: 18; stroke-linecap: round; stroke-linejoin: round; }
  .s-tube { fill: none; stroke: var(--accent-soft); stroke-width: 14; stroke-linecap: round; stroke-linejoin: round; }
  .s-bar { stroke-width: 4; }
  .s-pen { stroke-width: 5; }

  /* 살짝 살아 있는 그림: 메트로놈 진자, 흔들리는 종, 날숨 파형이 그려지는 모습 */
  @media (prefers-reduced-motion: no-preference) {
    .s-pendulum { transform-origin: 118px 144px; animation: swing 1.6s var(--ease-in-out) infinite alternate; }
    .s-pendulum + circle { transform-origin: 118px 144px; animation: swing 1.6s var(--ease-in-out) infinite alternate; }
    .s-bell { transform-origin: 230px 30px; animation: ring 1.2s ease-in-out infinite; }
    .s-wire { animation: flow 1.4s linear infinite; }
  }
  @keyframes swing { from { transform: rotate(-14deg); } to { transform: rotate(26deg); } }
  @keyframes ring { 0%, 60%, 100% { transform: rotate(0); } 10% { transform: rotate(-8deg); } 25% { transform: rotate(7deg); } 40% { transform: rotate(-4deg); } }
  @keyframes flow { to { stroke-dashoffset: -24; } }
</style>
