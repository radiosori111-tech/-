---
// 4컷 만화의 그림. 글자는 넣지 않아 어느 언어 글에서나 그대로 쓴다.
// 색은 사이트 토큰을 따른다: 선 --ink, 강조 --accent, 경보 --danger.
import type { Scene } from './scenes';

interface Props { scene: Scene; label?: string }
const { scene, label } = Astro.props;
---
<svg class="scene" viewBox="0 0 320 220" {...(label ? { role: 'img', 'aria-label': label } : { 'aria-hidden': 'true' })}>
  {label && <title>{label}</title>}
  {scene === 'alarm' && (
    <g>
      {/* 마감 앞의 책상: 얕고 빠른 숨, 머리 위에서 울리는 경보 */}
      <path class="s-floor" d="M24 196h272" />
      <rect class="s-soft" x="150" y="118" width="112" height="70" rx="8" />
      <path class="s-line" d="M150 188h112M162 130h88v44h-88z" />
      <path class="s-faint" d="M174 144h46M174 154h62M174 164h34" />
      <circle class="s-fill-paper s-line" cx="92" cy="98" r="30" />
      <path class="s-line" d="M50 196c2-40 18-58 42-58s40 18 42 58" />
      <path class="s-line" d="M84 92h.01M101 92h.01" />
      <path class="s-line" d="M86 110c4-3 9-3 13 0" />
      <path class="s-alert s-zig" d="M126 104l8-5 6 7 8-6 6 7" />
      <path class="s-alert s-zig" d="M126 116l8-4 6 6 8-5" />
      <g class="s-bell">
