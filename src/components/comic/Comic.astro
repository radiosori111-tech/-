---
// 글 머리의 4컷 만화 (1컷 상황 → 2컷 원리 → 3컷 실천 → 4컷 변화).
// 컷은 정사각형이라 scripts/export-comic.mjs로 한 컷씩 1080×1080 이미지로 뽑아
// 인스타그램 · 네이버 클립에도 그대로 쓸 수 있다.
import SceneArt from './Scene.astro';
import type { Scene } from './scenes';
import { t, DEFAULT_LANG, type Lang } from '../../i18n/ui';

interface Panel {
  scene?: Scene;
  image?: string;
  alt: string;
  label: string;
  caption: string;
  bubble?: string;
}
interface Props {
  comic: { title?: string; panels: Panel[] };
  lang?: Lang;
}
const { comic, lang = DEFAULT_LANG } = Astro.props;

// 그림 설명(alt)은 그림만 묘사해 글마다 겹치므로, 만화 제목 · 컷 번호 · 말풍선 · 설명을 붙여
// 컷마다 내용이 드러나는 대체 텍스트를 만든다. 검색 · 광고 크롤러와 화면 낭독기가 이 글을 읽는다.
const PANEL_NAME: Record<Lang, (n: number, label: string) => string> = {
  ko: (n, label) => `4컷 만화 ${n}컷(${label})`,
  en: (n, label) => `Four-panel comic, panel ${n} (${label})`,
  ja: (n, label) => `4コマ漫画 ${n}コマ目（${label}）`,
};
const plain = (html: string) => html.replace(/<[^>]+>/g, '').replace(/\s+/g, ' ').trim();
const panelAlt = (p: Panel, i: number) => {
  const head = [comic.title, PANEL_NAME[lang](i + 1, p.label)].filter(Boolean).join(' · ');
  const bubble = p.bubble ? ` “${p.bubble}”` : '';
  const stop = lang === 'ja' ? '。' : '.';
  return `${head}: ${p.alt}${stop}${bubble} ${plain(p.caption)}`.trim();
};

// 만화 아래에 컷마다 그림 묘사와 말풍선을 글로 보여 준다. 그림을 보기 어려운 독자도 같은 내용을 읽는다
const TRANSCRIPT: Record<Lang, { title: string; panel: (n: number, label: string) => string; picture: string; bubble: string; quote?: [string, string] }> = {
  ko: { title: '만화를 글로 읽기', panel: (n, label) => `${n}컷 · ${label}`, picture: '그림', bubble: '말풍선' },
  en: { title: 'The comic in words', panel: (n, label) => `Panel ${n} · ${label}`, picture: 'Picture', bubble: 'Speech bubble' },
  ja: { title: 'マンガを文章で読む', panel: (n, label) => `${n}コマ目・${label}`, picture: '絵', bubble: 'ふきだし', quote: ['「', '」'] },
};
const tr = TRANSCRIPT[lang];
const [qOpen, qClose] = tr.quote ?? ['“', '”'];
---
<section class="comic" aria-labelledby="comic-title" data-comic>
  <header class="comic-head">
    <p class="comic-kicker">{t(lang).post.comic}</p>
    {comic.title && <h2 id="comic-title" class="comic-title">{comic.title}</h2>}
  </header>
  <ol class="comic-grid">
    {comic.panels.map((p, i) => (
      <li class="comic-panel" data-panel={i + 1} data-scene={p.scene}>
        <p class="panel-label"><span class="panel-no tabular">{i + 1}</span>{p.label}</p>
        <figure class="panel-art">
          {p.image ? <img src={p.image} alt={panelAlt(p, i)} loading="lazy" decoding="async" /> : p.scene && <SceneArt scene={p.scene} label={panelAlt(p, i)} />}
          {p.bubble && <p class="panel-bubble">{p.bubble}</p>}
        </figure>
        <p class="panel-caption" set:html={p.caption} />
      </li>
    ))}
  </ol>
  <div class="comic-transcript">
    <p class="transcript-title">{tr.title}</p>
    <ol class="transcript-list">
      {comic.panels.map((p, i) => (
        <li>
          <strong>{tr.panel(i + 1, p.label)}</strong>
          <span class="transcript-line"><span class="transcript-key">{tr.picture}</span>{p.alt}</span>
          {p.bubble && <span class="transcript-line"><span class="transcript-key">{tr.bubble}</span>{qOpen}{p.bubble}{qClose}</span>}
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .comic { margin: 0 0 2.75rem; }
  .comic-head { margin-bottom: 1rem; }
  .comic-kicker { margin: 0 !important; font-size: var(--text-sm); font-weight: 700; color: var(--accent-strong); letter-spacing: -0.01em; }
  .comic-title {
    margin: 0.25rem 0 0 !important;
    font-size: var(--text-xl) !important;
    line-height: 1.4 !important;
    letter-spacing: -0.03em;
    color: var(--ink);
  }

  .comic-grid {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.75rem;
    margin: 0 !important;
    padding: 0 !important;
    counter-reset: none;
  }
  .comic-panel {
    position: relative;
    display: flex;
    flex-direction: column;
    aspect-ratio: 1 / 1;
    margin: 0 !important;
    padding: 1rem 1rem 1.125rem !important;
    border: 1px solid var(--line);
    border-radius: var(--radius-card);
    background: var(--surface);
    box-shadow: var(--shadow-sm);
    overflow: hidden;
  }
  .panel-label {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin: 0 !important;
    font-size: var(--text-xs);
    font-weight: 700;
    line-height: 1.4;
    color: var(--muted);
  }
  .panel-no {
    display: grid;
    place-items: center;
    width: 1.375rem; height: 1.375rem;
    border-radius: 999px;
    background: var(--frame);
    color: #fff;
    font-size: 0.75rem;
  }
  .panel-art {
    position: relative;
    flex: 1;
    min-height: 0;
    margin: 0.5rem 0 0;
    padding: 0.25rem 0.5rem;
  }
  .panel-art img { width: 100%; height: 100%; object-fit: contain; border-radius: 0; background: none; }
  .panel-bubble {
    position: absolute;
    top: 0.25rem;
    left: 0.25rem;
    max-width: 62%;
    margin: 0 !important;
    padding: 0.4375rem 0.75rem;
    border: 1.5px solid var(--ink);
    border-radius: 14px 14px 14px 4px;
    background: var(--surface);
    font-size: 0.8125rem;
    font-weight: 700;
    line-height: 1.45;
    color: var(--ink);
    text-align: left;
  }
  .panel-caption {
    margin: 0.5rem 0 0 !important;
    font-size: 0.875rem;
    line-height: 1.6;
    color: var(--ink-soft);
    letter-spacing: -0.01em;
  }
  .panel-caption :global(strong) { color: var(--ink); font-weight: 700; }

  .comic-transcript {
    margin-top: 1rem;
    padding: 1rem 1.125rem;
    border: 1px solid var(--line);
    border-radius: var(--radius-card);
    background: var(--surface);
  }
  .transcript-title { margin: 0 0 0.5rem !important; font-size: var(--text-sm); font-weight: 700; color: var(--ink); }
  .transcript-list {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.625rem 1.25rem;
    margin: 0 !important;
    padding: 0 !important;
    font-size: 0.875rem;
    line-height: 1.6;
    color: var(--ink-soft);
  }
  .transcript-list li { margin: 0 !important; padding: 0 !important; }
  .transcript-list strong { display: block; color: var(--ink); font-weight: 700; }
  .transcript-line { display: block; }
  .transcript-key { margin-right: 0.375rem; font-size: var(--text-xs); font-weight: 700; color: var(--muted); }

  @media (prefers-reduced-motion: no-preference) {
    .comic-panel { animation: panel-in 420ms var(--ease-out) both; }
    .comic-panel:nth-child(2) { animation-delay: 70ms; }
    .comic-panel:nth-child(3) { animation-delay: 140ms; }
    .comic-panel:nth-child(4) { animation-delay: 210ms; }
  }
  @keyframes panel-in { from { opacity: 0; transform: translateY(8px); } }

  @media (max-width: 560px) {
    .comic-grid { grid-template-columns: minmax(0, 1fr); gap: 0.875rem; }
    .comic-panel { padding: 1.125rem 1.125rem 1.25rem !important; }
    .panel-caption { font-size: 0.9375rem; }
    .panel-bubble { font-size: 0.875rem; }
    .transcript-list { grid-template-columns: minmax(0, 1fr); font-size: 0.9375rem; }
  }
</style>
