---
import { minutesOfDay } from '../data/site';

interface Pin { slug: string; title: string; time: string; moment: string }
interface Props { pins: Pin[] }

const { pins } = Astro.props;
const placed = pins
  .map((p) => ({ ...p, pct: ((minutesOfDay(p.time) ?? 0) / 1440) * 100 }))
  .sort((a, b) => a.pct - b.pct);
const hours = [0, 3, 6, 9, 12, 15, 18, 21, 24];
---
<div class="dayband" data-dayband>
  <p class="visually-hidden">하루 24시간 위에 놓인 아티클: 각 글은 그 습관이 일어나는 시각에 표시됩니다.</p>
  <div class="band-inner">
    <div class="track" aria-hidden="true">
      <span class="elapsed" data-elapsed></span>
      <span class="journey" data-journey hidden></span>
      {hours.map((h) => <span class="tick" style={`left:${(h / 24) * 100}%`}></span>)}
    </div>
    <ol class="pins">
      {placed.map((p) => (
        <li class:list={['pin', p.pct > 70 && 'pin-end']} style={`--x:${p.pct}%`} data-minute={minutesOfDay(p.time)}>
          <a href={`/articles/${p.slug}/`}>
            <span class="pin-dot" aria-hidden="true"></span>
            <span class="pin-label">
              <span class="time-mark">{p.time}</span>
              <span class="pin-moment">{p.moment}</span>
            </span>
            <span class="visually-hidden">: {p.title}</span>
          </a>
        </li>
      ))}
    </ol>
    <span class="now" data-now hidden aria-hidden="true"><span class="now-label tabular" data-now-label>지금</span></span>
    <div class="hours tabular" aria-hidden="true">
      {hours.map((h) => <span style={`left:${(h / 24) * 100}%`}>{String(h).padStart(2, '0')}</span>)}
    </div>
  </div>
</div>

<script>
  function placeNow() {
    document.querySelectorAll<HTMLElement>('[data-dayband]').forEach((band) => {
      const d = new Date();
      const minute = d.getHours() * 60 + d.getMinutes();
      const pct = (minute / 1440) * 100;
      const now = band.querySelector<HTMLElement>('[data-now]');
      const label = band.querySelector<HTMLElement>('[data-now-label]');
      const elapsed = band.querySelector<HTMLElement>('[data-elapsed]');
      if (now && label) {
        now.style.setProperty('--x', `${pct}%`);
        label.textContent = `지금 ${String(d.getHours()).padStart(2, '0')}:${String(d.getMinutes()).padStart(2, '0')}`;
        now.classList.toggle('now-end', pct > 82);
        now.hidden = false;
      }
      if (elapsed) {
        elapsed.style.setProperty('--x', `${pct}%`);
        requestAnimationFrame(() => band.classList.add('is-live'));
      }
      // 지금 이후 가장 가까운 시각의 글이 '해'를 받는다. 오늘 남은 글이 없으면 내일 첫 글.
      const pinEls = [...band.querySelectorAll<HTMLElement>('.pin')];
      const next = pinEls.find((p) => Number(p.dataset.minute) >= minute) ?? pinEls[0];
      pinEls.forEach((p) => p.classList.toggle('is-next', p === next));
      // 지금에서 다음 글까지 남은 시간 여정. 다음 글이 내일이면 오늘 끝(24시)까지 잇는다
      const journey = band.querySelector<HTMLElement>('[data-journey]');
      if (journey && next) {
        const to = Number(next.dataset.minute) >= minute ? (Number(next.dataset.minute) / 1440) * 100 : 100;
        journey.style.setProperty('--from', `${pct}%`);
        journey.style.setProperty('--to', `${to}%`);
        journey.hidden = to - pct < 0.5;
      }
    });
  }
  placeNow();
  setInterval(placeNow, 60_000);
</script>

<style>
  .dayband { margin-top: clamp(3rem, 6vw, 4.5rem); padding-block: 1.75rem 1rem; border-top: 1px solid var(--frame-line); }
  .band-inner { position: relative; height: 7.5rem; }

  .track {
    position: absolute;
    left: 0; right: 0;
    top: 4.5rem;
    height: 3px;
    border-radius: 3px;
    /* 우주 배경 위에서도 보이도록 밝은 선과 은은한 빛을 준다 */
    background: rgb(220 228 255 / 0.28);
    box-shadow: 0 0 10px rgb(150 170 255 / 0.25);
  }
  .elapsed {
    position: absolute;
    left: 0; top: 0; bottom: 0;
    width: var(--x, 0%);
    border-radius: inherit;
    background: linear-gradient(90deg, rgb(95 208 192 / 0.35), var(--accent-on-dark) 70%, #e9fffb);
    box-shadow: 0 0 12px rgb(95 208 192 / 0.7), 0 0 3px rgb(233 255 251 / 0.8);
    transform-origin: left center;
    transform: scaleX(0);
    transition: transform 1.2s var(--ease-out);
  }
  .is-live .elapsed { transform: scaleX(1); }
  /* 지금 → 다음 글: 점선 위로 빛 하나가 다음 습관 시각을 향해 흘러간다 */
  .journey {
    position: absolute;
    top: 0; bottom: 0;
    left: var(--from);
    width: calc(var(--to) - var(--from));
    background: repeating-linear-gradient(90deg, rgb(253 214 99 / 0.75) 0 6px, transparent 6px 12px);
    filter: drop-shadow(0 0 4px rgb(253 214 99 / 0.6));
    opacity: 0;
    transition: opacity 600ms ease 900ms;
  }
  .is-live .journey { opacity: 1; }
  .journey::after {
    content: '';
    position: absolute;
    top: 50%;
    left: 0;
    width: 9px; height: 9px;
    margin: -4.5px 0 0 -4.5px;
    border-radius: 50%;
    background: #fff6dc;
    box-shadow: 0 0 10px 3px rgb(253 214 99 / 0.85), 0 0 22px 6px rgb(95 208 192 / 0.35);
    animation: journey 4.5s var(--ease-in-out) infinite;
  }
  @keyframes journey {
    0% { left: 0; opacity: 0; }
    12% { opacity: 1; }
    85% { opacity: 1; }
    100% { left: 100%; opacity: 0; }
  }
  @media (prefers-reduced-motion: reduce) { .journey::after { animation: none; left: 100%; } }
  .tick {
    position: absolute;
    top: -4px;
    width: 1px; height: 11px;
    background: rgb(220 228 255 / 0.4);
  }

  .pins { list-style: none; }
  .pin {
    position: absolute;
    left: var(--x);
    top: 0;
    height: 4.5rem;
  }
  .pin a {
    position: absolute;
    left: 0; top: 0; bottom: -0.5rem;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    justify-content: space-between;
    text-decoration: none;
    padding-right: 0.5rem;
  }
  .pin-dot {
    order: 2;
    width: 11px; height: 11px;
    margin-left: -5px;
    border-radius: 50%;
    background: var(--frame);
    border: 2px solid var(--frame-faint);
    transition: background-color 200ms ease, border-color 200ms ease, transform 200ms var(--ease-out);
  }
  .pin-label {
    order: 1;
    display: grid;
    gap: 0.125rem;
    margin-left: -5px;
    padding-left: 0.75rem;
    border-left: 1px solid rgb(220 228 255 / 0.3);
    padding-bottom: 0.5rem;
    white-space: nowrap;
    font-size: 0.875rem;
  }
  .pin-end a { left: auto; right: 0; align-items: flex-end; padding-right: 0; padding-left: 0.5rem; }
  .pin-end .pin-dot { margin-left: 0; margin-right: -6px; }
  .pin-end .pin-label {
    margin-left: 0; margin-right: -6px;
    padding-left: 0; padding-right: 0.75rem;
    border-left: 0; border-right: 1px solid rgb(220 228 255 / 0.3);
    text-align: right;
  }
  .pin .time-mark { color: var(--frame-muted); transition: color 150ms ease; }
  .pin-moment { color: var(--frame-muted); transition: color 150ms ease; }
  .pin a:hover .pin-moment, .pin a:focus-visible .pin-moment { color: var(--frame-text); }
  .pin a:hover .pin-dot { border-color: var(--frame-text); }

  .pin.is-next .pin-dot {
    background: var(--accent-on-dark);
    border-color: var(--accent-on-dark);
    outline: 1px solid var(--accent-on-dark);
    outline-offset: 3px;
  }
  .pin.is-next .time-mark { color: var(--accent-on-dark); }
  .pin.is-next .pin-moment { color: var(--frame-text); }
  .pin.is-next .pin-label { border-color: rgb(95 208 192 / 0.5); }

  .now {
    position: absolute;
    left: var(--x);
    top: 4.5rem;
    width: 0;
  }
  .now::before {
    content: '';
    position: absolute;
    left: -1px; top: -0.875rem;
    width: 2px; height: 1.875rem;
    background: var(--frame-text);
    border-radius: 2px;
  }
  .now-label {
    position: absolute;
    top: 2.125rem;
    left: 0.5rem;
    white-space: nowrap;
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--frame-text);
  }
  .now-end .now-label { left: auto; right: 0.5rem; }

  .hours {
    position: absolute;
    left: 0; right: 0;
    top: 5.25rem;
    font-size: 0.75rem;
    color: var(--frame-muted);
  }
  .hours span { position: absolute; transform: translateX(-50%); }
  .hours span:first-child { transform: none; }
  .hours span:last-child { transform: translateX(-100%); }

  @media (max-width: 720px) {
    .band-inner { height: 8.25rem; }
    .pin-moment { display: none; }
    .pin-label { font-size: 0.8125rem; }
    .hours span:nth-child(even) { display: none; }
    .now-label { top: 2.75rem; }
  }
</style>
