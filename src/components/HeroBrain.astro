---
// 프레임 머리 영역 왼쪽의 빛나는 뇌. 배경처럼 깔리지만 그림의 뜻은 대체 텍스트로 전한다
import { DEFAULT_LANG, type Lang } from '../i18n/ui';

interface Props { lang?: Lang }
const { lang = DEFAULT_LANG } = Astro.props;
const ALT: Record<Lang, string> = {
  ko: '깔끔한 어두운 배경 위의 현대적인 3D 인체 뇌 의학 일러스트레이션. 좋은 습관으로 전전두엽과 해마가 밝게 빛나고, 습관이 자리 잡으며 전전두엽의 빛이 붉은 기저핵으로 옮겨 가는 긍정적인 변화를 보여 줍니다',
  en: 'A modern 3D medical illustration of the human brain on a clean dark background. The prefrontal cortex and hippocampus glow with good habits, and light moves from the prefrontal cortex to the red basal ganglia as a habit settles in, showing positive change',
  ja: 'すっきりとした暗い背景に描いた、現代的な3Dの人間の脳の医学イラスト。良い習慣で前頭前野と海馬が明るく光り、習慣が根づくにつれて前頭前野の光が赤い大脳基底核へ移っていく前向きな変化を表しています。',
};
---
<img class="hero-brain" src="/cosmos-brain.svg" alt={ALT[lang]} width="640" height="460" decoding="async" />
