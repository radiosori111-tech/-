---
// 글 페이지의 애드센스 광고 자리 (PostLayout이 4컷 만화 아래와 본문 끝에 둔다).
// - 배포 빌드 + 게시자 ID(adsenseClient) + 이 자리의 광고 단위 번호(adSlots)가 모두 있으면 광고 단위를 넣는다.
// - 광고 단위 번호가 없으면 아무것도 넣지 않는다. 이때는 <head>의 공통 스크립트로 자동 광고만 동작한다.
// - 개발 중(npm run dev)에는 광고 대신 점선 자리만 보여 준다.
import { SITE } from '../../data/site';
import { t, DEFAULT_LANG, type Lang } from '../../i18n/ui';

interface Props {
  position: 'top' | 'bottom';
  lang?: Lang;
}
const { position, lang = DEFAULT_LANG } = Astro.props;
const client = SITE.adsenseClient.trim();
const slot = position === 'top' ? SITE.adSlots.postTop : SITE.adSlots.postBottom;
const live = import.meta.env.PROD && client.startsWith('ca-pub-') && slot;
const preview = import.meta.env.DEV;
const adLabel = t(lang).post.ad;
const previewText = position === 'top' ? '글 상단 광고 자리 (4컷 만화 아래)' : '글 하단 광고 자리 (본문 끝)';
---
{(live || preview) && (
  <aside class="ad" aria-label={adLabel} data-ad-position={position}>
    <span class="ad-label">{adLabel}</span>
    {live ? (
      <>
        <ins
          class="adsbygoogle"
          style="display:block"
          data-ad-client={client}
          data-ad-slot={slot}
          data-ad-format="auto"
          data-full-width-responsive="true"
        ></ins>
        <script is:inline>(window.adsbygoogle = window.adsbygoogle || []).push({});</script>
      </>
    ) : (
      <div class="ad-preview">{previewText} · 애드센스 ID와 광고 단위 번호를 넣으면 이 자리에 광고가 나옵니다</div>
    )}
  </aside>
)}

<style>
  .ad { margin-block: 2.5rem; line-height: 1.5; }
  .ad:first-child { margin-top: 0; }
  .ad-label {
    display: block;
    margin-bottom: 0.5rem;
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 0.02em;
    color: var(--muted);
  }
  /* 광고가 늦게 채워져도 아래 글이 밀리지 않도록 높이를 먼저 잡아 둔다 */
  .ad :global(.adsbygoogle) { min-height: 7.5rem; }
  .ad-preview {
    display: grid;
    place-items: center;
    min-height: 7.5rem;
    padding: 1rem;
    border: 1px dashed var(--line-strong);
    border-radius: var(--radius-card);
    background: var(--sunk);
    font-size: var(--text-sm);
    color: var(--muted);
    text-align: center;
  }
</style>
