---
interface Props { name: 'check' | 'flag' | 'link' | 'share' | 'arrow-right' | 'arrow-left' | 'mail' | 'copy' | 'list' | 'heart' | 'spark' | 'x' | 'facebook' | 'info' | 'chevron-down' | 'search' | 'close'; label?: string }
const { name, label } = Astro.props;
---
<svg class="icon" viewBox="0 0 24 24" aria-hidden={label ? undefined : 'true'} role={label ? 'img' : undefined} aria-label={label}>
  {name === 'check' && <path d="M5 12.5l4.2 4.2L19 7" />}
  {name === 'flag' && <><path d="M6 21V4" /><path d="M6 4h11l-2.5 4L17 12H6" /></>}
  {name === 'link' && <><path d="M10 14a4.5 4.5 0 0 0 6.4 0l3-3a4.5 4.5 0 0 0-6.4-6.4l-1 1" /><path d="M14 10a4.5 4.5 0 0 0-6.4 0l-3 3a4.5 4.5 0 0 0 6.4 6.4l1-1" /></>}
  {name === 'share' && <><circle cx="6" cy="12" r="2.5" /><circle cx="17.5" cy="5.5" r="2.5" /><circle cx="17.5" cy="18.5" r="2.5" /><path d="M8.2 10.8l7.1-4M8.2 13.2l7.1 4" /></>}
  {name === 'arrow-right' && <path d="M4 12h15M13 6l6 6-6 6" />}
  {name === 'arrow-left' && <path d="M20 12H5M11 6l-6 6 6 6" />}
  {name === 'mail' && <><rect x="3" y="5.5" width="18" height="13" rx="1.5" /><path d="M3.5 6.5l8.5 6.5 8.5-6.5" /></>}
  {name === 'copy' && <><rect x="8.5" y="8.5" width="11" height="11" rx="1.5" /><path d="M15.5 8.5V6a1.5 1.5 0 0 0-1.5-1.5H6A1.5 1.5 0 0 0 4.5 6v8A1.5 1.5 0 0 0 6 15.5h2.5" /></>}
  {name === 'list' && <path d="M9 6h11M9 12h11M9 18h11M4.5 6h.01M4.5 12h.01M4.5 18h.01" />}
  {name === 'heart' && <path d="M12 20s-7.5-4.6-7.5-10.2A4.3 4.3 0 0 1 12 7.3a4.3 4.3 0 0 1 7.5 2.5C19.5 15.4 12 20 12 20z" />}
  {name === 'spark' && <><circle cx="12" cy="12" r="3.5" /><path d="M12 2.5v3M12 18.5v3M2.5 12h3M18.5 12h3M5.3 5.3l2.1 2.1M16.6 16.6l2.1 2.1M5.3 18.7l2.1-2.1M16.6 7.4l2.1-2.1" /></>}
  {name === 'x' && <path class="icon-solid" d="M17.75 3h3.07l-6.7 7.66L22 21h-6.17l-4.83-6.32L5.47 21H2.4l7.17-8.2L2 3h6.33l4.37 5.78L17.75 3zm-1.08 16.17h1.7L7.4 4.73H5.58l11.09 14.44z" />}
  {name === 'search' && <><circle cx="11" cy="11" r="6.5" /><path d="M16 16l4.5 4.5" /></>}
  {name === 'close' && <path d="M6 6l12 12M18 6L6 18" />}
  {name === 'chevron-down' && <path d="M6 9l6 6 6-6" />}
  {name === 'info' && <><circle cx="12" cy="12" r="9" /><path d="M12 11v5.5M12 7.5h.01" /></>}
  {name === 'facebook' && <path d="M14.5 21v-7.5h2.6l.4-3h-3V8.6c0-.9.3-1.5 1.6-1.5h1.6V4.4c-.3 0-1.2-.1-2.3-.1-2.3 0-3.9 1.4-3.9 4v2.2H8.9v3h2.6V21" />}
</svg>
