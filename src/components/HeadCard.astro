---
// 머리 영역 오른쪽 카드 (블로그의 최신글 · 아티클의 추천 아티클이 함께 쓴다). 붉은 배지 + 제목 + 설명 + 정보 줄 + 읽기
import Icon from './Icon.astro';

interface Props { badge: string; href: string; title: string; description: string; readLabel: string }
const { badge, href, title, description, readLabel } = Astro.props;
---
<article class="latest">
  <p class="latest-badge"><span class="latest-dot" aria-hidden="true"></span>{badge}</p>
  <h2><a href={href}>{title}</a></h2>
  <p class="latest-desc">{description}</p>
  <div class="latest-foot">
    <p class="latest-meta tabular"><slot /></p>
    <span class="latest-go" aria-hidden="true">{readLabel} <Icon name="arrow-right" /></span>
  </div>
</article>

<style>
  /* 우주 배경 위에서도 글자가 또렷하도록 짙은 유리 */
  .latest {
    position: relative;
    padding: 1.75rem;
    border: 1px solid var(--frame-line);
    border-radius: var(--radius-lg);
    background: rgb(12 17 31 / 0.82);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    box-shadow: 0 24px 48px -24px rgb(0 0 0 / 0.6);
    transition: border-color 200ms ease, transform 240ms var(--ease-out);
  }
  .latest :is(h2, p) { text-shadow: none; }
  .latest-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 1rem;
    padding: 0.3125rem 0.75rem;
    border: 1px solid rgb(255 92 108 / 0.45);
    border-radius: 999px;
    background: rgb(255 92 108 / 0.14);
    color: #ff7d88;
    font-size: var(--text-sm);
    font-weight: 700;
    letter-spacing: 0.02em;
  }
  .latest-dot { width: 7px; height: 7px; border-radius: 50%; background: #ff5c6c; box-shadow: 0 0 0 0 rgb(255 92 108 / 0.6); animation: latest-pulse 2.4s ease-out infinite; }
  @keyframes latest-pulse { 0% { box-shadow: 0 0 0 0 rgb(255 92 108 / 0.6); } 70%, 100% { box-shadow: 0 0 0 7px rgb(255 92 108 / 0); } }
  .latest h2 { font-size: var(--text-2xl); font-weight: 700; line-height: 1.4; letter-spacing: -0.03em; color: var(--frame-text); }
  .latest h2 a { text-decoration: none; color: inherit; }
  .latest h2 a::after { content: ''; position: absolute; inset: 0; border-radius: inherit; }
  .latest h2 a:focus-visible { outline: none; }
  .latest:has(h2 a:focus-visible) { outline: 2px solid var(--accent-on-dark); outline-offset: 3px; }
  .latest-desc {
    margin-top: 0.75rem;
    color: var(--frame-muted);
    line-height: 1.75;
    font-size: var(--text-ui);
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .latest-foot {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem 1rem;
    margin-top: 1.5rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--frame-line);
  }
  .latest-meta { display: flex; flex-wrap: wrap; gap: 0.375rem 0.875rem; font-size: var(--text-sm); color: var(--frame-muted); }
  .latest-go {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    padding: 0.5rem 0.875rem;
    border-radius: var(--radius);
    background: var(--accent-on-dark);
    color: var(--frame);
    font-size: var(--text-sm);
    font-weight: 700;
  }
  .latest-go :global(.icon) { width: 1rem; height: 1rem; transition: transform 220ms var(--ease-out); }
  @media (hover: hover) and (pointer: fine) {
    .latest:hover { border-color: var(--frame-line-hover); }
  }
  @media (hover: hover) and (pointer: fine) and (prefers-reduced-motion: no-preference) {
    .latest:hover { transform: translateY(-2px); }
    .latest:hover .latest-go :global(.icon) { transform: translateX(3px); }
  }
  @media (prefers-reduced-motion: reduce) { .latest-dot { animation: none; } }
  @media (max-width: 640px) { .latest { padding: 1.375rem; } }
  .latest-meta :global(.time-mark) { color: var(--accent-on-dark); font-weight: 700; }
</style>
