---
import Icon from './Icon.astro';
import { t, DEFAULT_LANG, type Lang } from '../i18n/ui';
import { seoulISO } from '../data/site';

// dateOnly: 본문 끝에 글마다 쓴 면책 섹션이 있으면 공통 면책은 되풀이하지 않고 정보 기준일 한 줄만 그린다
interface Props { reviewed?: Date; lang?: Lang; dateOnly?: boolean }
const { reviewed, lang = DEFAULT_LANG, dateOnly = false } = Astro.props;
const d = t(lang).disclaimer;
const reviewedHtml = reviewed && d.reviewed(`<time datetime="${seoulISO(reviewed)}">${d.reviewedDate(reviewed)}</time>`);
---
{dateOnly ? (reviewedHtml && <p class="d-date d-date-only tabular" set:html={reviewedHtml} />) : (
<aside class="disclaimer-box" role="note" aria-labelledby="disclaimer-title">
  <h2 id="disclaimer-title" class="d-title"><Icon name="info" /> {d.title}</h2>
  <ul>
    {d.items.map((item) => <li set:html={item} />)}
  </ul>
  <p class="d-link" set:html={d.links} />
  {reviewedHtml && <p class="d-date tabular" set:html={reviewedHtml} />}
</aside>
)}

<style>
  .d-date-only { margin-top: 2rem !important; }
  .disclaimer-box {
    margin-top: 3rem;
    padding: clamp(1.25rem, 3vw, 1.75rem);
    border: 1px solid var(--line);
    border-radius: var(--radius-card);
    background: var(--surface);
    box-shadow: var(--shadow-sm);
    color: var(--ink);
  }
  .d-title {
    display: flex !important;
    align-items: center;
    gap: 0.5rem;
    margin: 0 0 0.875rem !important;
    padding: 0 !important;
    border: 0 !important;
    font-size: var(--text-md) !important;
    font-weight: 700 !important;
    letter-spacing: -0.02em;
    color: var(--ink);
  }
  .d-title::before { display: none !important; }
  .d-title :global(.icon) { width: 1.25rem; height: 1.25rem; color: var(--accent); }
  .disclaimer-box ul { margin: 0 !important; padding-left: 1.2em !important; font-size: var(--text-ui); line-height: 1.75; color: var(--ink-soft); }
  .disclaimer-box li { margin-bottom: 0.375em !important; }
  .disclaimer-box li::marker { color: var(--muted); }
  .disclaimer-box :global(strong) { color: var(--ink); font-weight: 650; }
  .d-link { margin: 0.875rem 0 0 !important; font-size: var(--text-sm); line-height: 1.6; color: var(--ink-soft); }
  .d-link :global(a) { color: var(--accent-strong); font-weight: 600; }
  .d-link :global(a:hover) { color: var(--accent); }
  .d-date {
    margin: 1rem 0 0 !important;
    padding-top: 0.875rem;
    border-top: 1px solid var(--line);
    font-size: var(--text-xs);
    line-height: 1.6;
    color: var(--muted);
  }
</style>
