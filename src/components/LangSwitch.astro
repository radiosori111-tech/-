---
// 같은 글 · 목록의 다른 언어 페이지로 가는 작은 전환 단추. 언어가 하나뿐이면 그리지 않는다.
import { LANG_NAME, HREFLANG, type Lang, type Alternate } from '../i18n/ui';

interface Props { alternates: Alternate[]; current: Lang; label: string }
const { alternates, current, label } = Astro.props;
---
{alternates.length > 1 && (
  <nav class="lang-switch" aria-label={label}>
    {alternates.map((a) => (
      a.lang === current
        ? <span class="lang-on" aria-current="page" lang={HREFLANG[a.lang]}>{LANG_NAME[a.lang]}</span>
        : <a href={a.href} hreflang={HREFLANG[a.lang]} lang={HREFLANG[a.lang]}>{LANG_NAME[a.lang]}</a>
    ))}
  </nav>
)}

<style>
  .lang-switch {
    display: inline-flex;
    gap: 0.125rem;
    margin-top: 1.5rem;
    padding: 0.1875rem;
    border: 1px solid var(--frame-line);
    border-radius: 999px;
    background: var(--frame-raised);
    font-size: var(--text-sm);
  }
  .lang-switch a, .lang-on {
    padding: 0.3125rem 0.875rem;
    border-radius: 999px;
    line-height: 1.4;
    text-decoration: none;
    white-space: nowrap;
  }
  .lang-switch a {
    color: var(--frame-muted);
    transition: color 150ms ease, background-color 150ms ease, transform 160ms var(--ease-out);
  }
  .lang-switch a:hover { color: var(--frame-text); background: var(--frame-hover); }
  .lang-on { background: var(--accent-on-dark); color: var(--frame); font-weight: 700; }
  @media (prefers-reduced-motion: no-preference) {
    .lang-switch a:active { transform: scale(0.96); }
  }
</style>
