---
import { SITE } from '../data/site';
import { t, DEFAULT_LANG, type Lang } from '../i18n/ui';

interface Props {
  slot: string;
  // 광고 칸의 위치 이름 (개발 중 자리 표시에만 쓴다)
  label?: string;
  lang?: Lang;
}
const { slot, label = '광고', lang = DEFAULT_LANG } = Astro.props;
const adLabel = t(lang).post.ad;
const live = import.meta.env.PROD && SITE.adsenseClient && slot;
// 개발 중에는 광고 대신 자리만 보여 준다. 배포 빌드에서 ID가 없으면 아무것도 넣지 않는다.
const preview = import.meta.env.DEV;
---
{(live || preview) && (
  <aside class="ad" aria-label={adLabel}>
    <span class="ad-label">{adLabel}</span>
    {live ? (
      <>
        <ins
          class="adsbygoogle"
          style="display:block"
          data-ad-client={SITE.adsenseClient}
          data-ad-slot={slot}
          data-ad-format="auto"
          data-full-width-responsive="true"
        ></ins>
        <script is:inline>(window.adsbygoogle = window.adsbygoogle || []).push({});</script>
      </>
    ) : (
      <div class="ad-preview">{label} · 애드센스 ID를 넣으면 이 자리에 광고가 나옵니다</div>
    )}
  </aside>
)}

<style>
  .ad { margin-block: 2.5rem; line-height: 1.5; }
  .ad:first-child { margin-top: 0; }
  .ad-label {
    display: block;
    margin-bottom: 0.5rem;
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 0.02em;
    color: var(--muted);
  }
  /* 광고가 늦게 채워져도 아래 글이 밀리지 않도록 높이를 먼저 잡아 둔다 */
  .ad :global(.adsbygoogle) { min-height: 7.5rem; }
  .ad-preview {
    display: grid;
    place-items: center;
    min-height: 7.5rem;
    padding: 1rem;
    border: 1px dashed var(--line-strong);
    border-radius: var(--radius-card);
    background: var(--sunk);
    font-size: var(--text-sm);
    color: var(--muted);
    text-align: center;
  }
</style>
