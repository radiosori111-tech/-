---
// 블로그 글 한 편 (한국어 /blog/…, 영어 /en/blog/…, 일본어 /ja/blog/…가 함께 쓴다)
import { render } from 'astro:content';
import PostLayout from '../../layouts/PostLayout.astro';
import { SITE } from '../../data/site';
import { postUrl, postTags, postMinutes, postAlternates, type Post } from '../../data/blog';
import { t, homePath, formatDateFor, HREFLANG } from '../../i18n/ui';
import { readNext } from '../../data/related';
import { conceptNet } from '../../data/concepts';

interface Props { post: Post; newer: Post | null; older: Post | null }
const { post, newer, older } = Astro.props;
const { Content, headings } = await render(post);
const { title, description, date, updated, image, slug, lang, comic } = post.data;
const tr = t(lang).post;
const tags = postTags(post);
const url = postUrl(post);
const alternates = await postAlternates(post);
const wasUpdated = updated && updated.toDateString() !== date.toDateString();
const pagerLink = (p: Post | null) => p && { href: postUrl(p), title: p.data.title };
const next2 = await readNext('blog', post.data.translationOf ?? slug, lang);
const knowledge = await conceptNet(lang, url);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: title,
  description,
  datePublished: date.toISOString(),
  dateModified: (updated ?? date).toISOString(),
  ...(image && { image: new URL(image, Astro.site).toString() }),
  ...(tags.length && { keywords: tags.join(', ') }),
  inLanguage: HREFLANG[lang],
  author: { '@type': 'Organization', name: SITE.name },
  publisher: { '@type': 'Organization', name: SITE.name },
  mainEntityOfPage: new URL(url, Astro.site).toString(),
};
---
<PostLayout
  title={title}
  description={description}
  jsonLd={jsonLd}
  image={image}
  url={url}
  back={{ href: homePath(lang), label: tr.backBlog }}
  headings={headings}
  storageKey={`blog:${slug}`}
  reviewed={updated ?? date}
  tags={tags}
  prev={pagerLink(older)}
  next={pagerLink(newer)}
  prevLabel={tr.older}
  nextLabel={tr.newer}
  lang={lang}
  alternates={alternates}
  comic={comic}
  readNext={next2}
  knowledge={knowledge}
>
  <Fragment slot="meta">
    <div><dt class="visually-hidden">{tr.published}</dt><dd class="tabular"><time datetime={date.toISOString()}>{formatDateFor(lang, date)}</time></dd></div>
    {wasUpdated && <div><dt>{tr.updated}</dt><dd class="tabular"><time datetime={updated!.toISOString()}>{formatDateFor(lang, updated!)}</time></dd></div>}
    <div><dt class="visually-hidden">{tr.readTime}</dt><dd class="tabular">{tr.minutes(postMinutes(post))}</dd></div>
  </Fragment>
  <Content />
</PostLayout>
