---
// 블로그 목록 (한국어 /blog/, 영어 /en/blog/, 일본어 /ja/blog/가 함께 쓴다)
import Page from '../../layouts/Page.astro';
import Icon from '../Icon.astro';
import PostList, { type ListItem } from '../PostList.astro';
import LangSwitch from '../LangSwitch.astro';
import { getPosts, postUrl, postTags, postMinutes, listAlternates } from '../../data/blog';
import { t, formatDateFor, type Lang } from '../../i18n/ui';
import { seoulISO } from '../../data/site';
import DayBand from '../DayBand.astro';
import HeadCard from '../HeadCard.astro';
import { getArticles, articleUrl } from '../../data/articles';

interface Props { lang: Lang }
const { lang } = Astro.props;
const tr = t(lang);
const posts = await getPosts(lang);
const items: ListItem[] = posts.map((p) => ({
  href: postUrl(p),
  key: `blog:${p.data.slug}`,
  title: p.data.title,
  description: p.data.description,
  minutes: postMinutes(p),
  image: p.data.image,
  date: p.data.date,
  hay: [p.data.title, p.data.description, ...postTags(p)].join(' ').toLowerCase(),
}));
// 가장 최근 글은 머리의 '최신글' 카드로 올리고, 목록에서는 검색할 때만 다시 보인다
const latest = posts[0];
// 아티클 홈과 같은 하루 띠: 습관 시각이 있는 아티클을 하루 위에 놓는다
const pins = (await getArticles(lang))
  .filter((a) => a.data.time)
  .map((a) => ({ href: articleUrl(a), title: a.data.title, time: a.data.time!, moment: a.data.moment }));
---
<Page title={null} heading={tr.list.homeHeading} lede={tr.list.homeLede} lang={lang} alternates={listAlternates}>
  <LangSwitch slot="head" alternates={listAlternates} current={lang} label={tr.post.readIn} />
  {pins.length > 0 && <DayBand slot="band" pins={pins} lang={lang} />}
  {latest && (
    <HeadCard
      slot="feature"
      badge={tr.list.latest}
      href={postUrl(latest)}
      title={latest.data.title}
      description={latest.data.description}
      readLabel={tr.list.read}
    >
      <time datetime={seoulISO(latest.data.date)}>{formatDateFor(lang, latest.data.date)}</time>
      <span>{tr.post.minutes(postMinutes(latest))}</span>
    </HeadCard>
  )}
  <section aria-labelledby="list-title">
    <div class="list-head">
      <h2 id="list-title">{tr.list.all} <span class="count tabular" aria-live="polite" data-count-label={tr.list.count('{n}')}>{tr.list.count(String(posts.length))}</span></h2>
      <label class="search">
        <span class="visually-hidden">{tr.list.search}</span>
        <Icon name="search" />
        <input type="search" placeholder={tr.list.searchPlaceholder} title={tr.list.searchHint} autocomplete="off" enterkeyhint="search" data-search />
        <button type="button" class="search-clear" aria-label={tr.list.clear} data-clear hidden><Icon name="close" /></button>
      </label>
    </div>

    <div class="blog-list">
      <PostList items={items} images lang={lang} />
    </div>

    <div class="search-empty" data-search-empty hidden>
      <p><strong data-search-q></strong>{tr.list.noMatch}</p>
      <button type="button" class="btn btn-secondary btn-sm" data-clear>{tr.list.clear}</button>
    </div>
  </section>
</Page>

<script>
  const input = document.querySelector<HTMLInputElement>('[data-search]')!;
  const rows = [...document.querySelectorAll<HTMLElement>('[data-rows] .row')];
  const count = document.querySelector<HTMLElement>('[data-count-label]')!;
  const empty = document.querySelector<HTMLElement>('[data-search-empty]')!;
  const emptyQ = document.querySelector<HTMLElement>('[data-search-q]')!;
  const clearInline = document.querySelector<HTMLButtonElement>('.search-clear')!;
  const countLabel = count.dataset.countLabel!;
  const list = document.querySelector<HTMLElement>('[data-rows]');

  function apply() {
    const words = input.value.trim().toLowerCase().split(/\s+/).filter(Boolean);
    let shown = 0;
    rows.forEach((row) => {
      const hit = words.every((w) => row.dataset.hay!.includes(w));
      row.hidden = !hit;
      if (hit) shown++;
    });
    // 최신글은 머리 카드에 있으니, 검색할 때만 목록에 다시 보여 준다
    list?.classList.toggle('is-searching', words.length > 0);
    count.textContent = countLabel.replace('{n}', String(shown));
    clearInline.hidden = !input.value;
    empty.hidden = shown > 0;
    emptyQ.textContent = `‘${input.value.trim()}’`;
  }
  input.addEventListener('input', apply);
  document.querySelectorAll('[data-clear]').forEach((b) => b.addEventListener('click', () => {
    input.value = '';
    apply();
    input.focus();
  }));
  input.addEventListener('keydown', (e) => { if (e.key === 'Escape' && input.value) { input.value = ''; apply(); } });
  if (input.value) apply();
</script>

<style>
  .blog-list :global([data-rows]:not(.is-searching) > .row:first-child) { display: none; }

  .count { margin-left: 0.375rem; font-size: var(--text-md); font-weight: 600; letter-spacing: 0; color: var(--muted); }

  .search { position: relative; flex: 0 1 26rem; display: flex; align-items: center; }
  .search > :global(.icon) { position: absolute; left: 1rem; color: var(--muted); pointer-events: none; }
  .search input {
    width: 100%;
    min-height: 3rem;
    padding: 0.75rem 3rem 0.75rem 2.875rem;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: var(--surface);
    color: var(--ink);
    font: inherit;
    font-size: var(--text-ui);
    box-shadow: var(--shadow-sm);
    transition: border-color 150ms ease, box-shadow 200ms var(--ease-out);
  }
  .search input::placeholder { color: var(--placeholder); }
  .search input::-webkit-search-cancel-button { display: none; }
  .search input:hover { border-color: var(--line-hover); }
  .search input:focus { outline: none; border-color: var(--accent); box-shadow: 0 0 0 4px var(--accent-soft); }
  .search-clear {
    position: absolute;
    right: 0.375rem;
    display: grid;
    place-items: center;
    width: 2.25rem; height: 2.25rem;
    border: 0;
    border-radius: 999px;
    background: transparent;
    color: var(--muted);
    cursor: pointer;
    transition: background-color 150ms ease, color 150ms ease, transform 160ms var(--ease-out);
  }
  .search-clear:hover { background: var(--sunk); color: var(--ink); }
  .search-clear :global(.icon) { width: 1rem; height: 1rem; }
  @media (prefers-reduced-motion: no-preference) {
    .search-clear:active { transform: scale(0.92); }
  }

  .search-empty { display: grid; justify-items: center; gap: 1rem; padding: 4rem 1rem; text-align: center; color: var(--muted); }
  .search-empty strong { color: var(--ink); }

  @media (max-width: 640px) {
    .search { flex: 1 1 auto; }
  }
</style>
