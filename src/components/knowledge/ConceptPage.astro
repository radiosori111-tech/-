---
// 개념 하나를 모아 보는 페이지 (/concepts/<id>/, /en/…, /ja/…). 지식 지도에서 그 개념과 이웃을 밝히고, 그 개념을 다룬 글을 최신순으로 보여 준다
import Page from '../../layouts/Page.astro';
import PostList, { type ListItem } from '../PostList.astro';
import BrainAtlas from './BrainAtlas.astro';
import { CONCEPTS, conceptById, conceptEntries, conceptPath, neighbors } from '../../data/concepts';
import { LANGS, type Lang } from '../../i18n/ui';

interface Props { lang: Lang; id?: string }
const { lang, id } = Astro.props;
const entries = await conceptEntries(lang);
const counts = Object.fromEntries(CONCEPTS.map((c) => [c.id, entries.filter((e) => e.concepts.includes(c.id)).length]));
const T = {
  ko: { indexTitle: '지식 지도', indexLede: '이 사이트의 글은 열 가지 뇌과학 개념으로 서로 이어져 있습니다. 개념을 누르면 그 개념을 다룬 글을 모아 볼 수 있습니다.', map: '뇌과학 개념 열 가지와 그 사이의 연결을 그린 지식 지도', posts: '이 개념을 다룬 글', docTitle: (n: string) => `${n} 관련 뇌과학 글 모음`, near: '이웃한 개념', all: '전체 지식 지도' },
  en: { indexTitle: 'Knowledge map', indexLede: 'The posts on this site connect through ten brain science concepts. Choose one to see every post about it.', map: 'A map of ten brain science concepts and how they connect', posts: 'Posts on this concept', docTitle: (n: string) => `${n}: brain science posts`, near: 'Neighboring concepts', all: 'Full knowledge map' },
  ja: { indexTitle: '知識マップ', indexLede: 'このサイトの記事は、十の脳科学の概念でつながっています。概念を選ぶと、その概念を扱った記事をまとめて見られます。', map: '十の脳科学の概念とそのつながりを描いた知識マップ', posts: 'この概念を扱った記事', docTitle: (n: string) => `${n}に関する脳科学記事まとめ`, near: 'となりの概念', all: '知識マップ全体' },
}[lang];
const concept = id ? conceptById(id) : undefined;
const shown = concept ? entries.filter((e) => e.concepts.includes(concept.id)) : [];
const items: ListItem[] = shown.map((e) => ({ href: e.href, key: e.key, title: e.title, description: e.description, minutes: e.minutes, image: e.image, date: e.date, hay: e.hay }));
const alternates = LANGS.map((l) => ({ lang: l, href: conceptPath(l, id) }));
---
<Page title={concept ? T.docTitle(concept.name[lang]) : T.indexTitle} heading={concept ? concept.name[lang] : undefined} lede={concept ? concept.blurb[lang] : T.indexLede} lang={lang} alternates={alternates}>
  <section class="concept-map">
    <BrainAtlas lang={lang} current={concept?.id} />
    {concept && (
      <p class="concept-near">{T.near}: {neighbors(concept.id).map((n, i) => <>{i > 0 && ' · '}<a href={conceptPath(lang, n)}>{conceptById(n).name[lang]}</a></>)} · <a href={conceptPath(lang)}>{T.all}</a></p>
    )}
  </section>
  {concept && (
    <section class="concept-posts" aria-labelledby="concept-posts-title">
      <div class="list-head"><h2 id="concept-posts-title">{T.posts} <span class="count tabular">{items.length}</span></h2></div>
      <PostList items={items} images lang={lang} />
    </section>
  )}
</Page>

<style>
  .concept-map { display: grid; gap: 0.875rem; }
  .concept-near { font-size: var(--text-sm); color: var(--muted); }
  .concept-near a { color: var(--accent-strong); font-weight: 600; text-decoration: none; }
  .concept-near a:hover { text-decoration: underline; }
  .concept-posts { margin-top: clamp(3rem, 6vw, 4.5rem); }
  .count { margin-left: 0.375rem; font-size: var(--text-md); font-weight: 600; letter-spacing: 0; color: var(--muted); }
</style>
