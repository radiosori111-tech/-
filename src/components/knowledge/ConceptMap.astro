---
// 전체 지식 지도: 개념 10개와 그 사이의 선. 자바스크립트 없이 SVG 링크로만 움직인다
import { CONCEPTS, LINKS, conceptById, conceptPath } from '../../data/concepts';
import type { Lang } from '../../i18n/ui';

interface Props { lang: Lang; active?: string[]; counts?: Record<string, number>; label: string }
const { lang, active = [], counts = {}, label } = Astro.props;
const on = (id: string) => active.includes(id);
---
<figure class="map">
  <svg viewBox="0 0 640 300" role="img" aria-label={label}>
    <g class="map-links">
      {LINKS.map(([a, b]) => {
        const A = conceptById(a), B = conceptById(b);
        return <line x1={A.x} y1={A.y} x2={B.x} y2={B.y} class:list={[on(a) && on(b) && 'is-on']} />;
      })}
    </g>
    {CONCEPTS.map((c) => (
      <a href={conceptPath(lang, c.id)} class:list={['map-node', on(c.id) && 'is-on']} aria-current={active.length === 1 && on(c.id) ? 'page' : undefined}>
        <circle cx={c.x} cy={c.y} r="9" />
        <text x={c.x} y={c.y + 28} text-anchor="middle">{c.name[lang]}{counts[c.id] ? ` ${counts[c.id]}` : ''}</text>
      </a>
    ))}
  </svg>
</figure>

<style>
  .map { margin: 0; padding: 1rem; border: 1px solid var(--line); border-radius: var(--radius-card); background: var(--surface); box-shadow: var(--shadow-sm); overflow-x: auto; }
  svg { display: block; width: 100%; max-width: 48rem; min-width: 34rem; height: auto; margin-inline: auto; aspect-ratio: 640 / 300; overflow: visible; }
  .map-links line { stroke: var(--line-strong); stroke-width: 1.5; }
  .map-links line.is-on { stroke: var(--accent); stroke-width: 2.5; }
  .map-node circle { fill: var(--surface); stroke: var(--line-hover); stroke-width: 2; transition: fill 150ms ease, stroke 150ms ease; }
  .map-node text { font-size: 13px; font-weight: 600; fill: var(--muted); }
  .map-node.is-on circle { fill: var(--accent); stroke: var(--accent); }
  .map-node.is-on text { fill: var(--ink); font-weight: 700; }
  .map-node:hover circle, .map-node:focus-visible circle { stroke: var(--accent); }
  .map-node:hover text, .map-node:focus-visible text { fill: var(--accent-strong); }
  .map-node:focus-visible { outline: none; }
  .map-node:focus-visible circle { stroke-width: 3.5; }
</style>
