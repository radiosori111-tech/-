---
import Page from '../layouts/Page.astro';
---
<Page title="페이지를 찾을 수 없습니다" lede="주소가 바뀌었거나 삭제된 페이지입니다. 모든 아티클 목록에서 읽을 글을 찾아보세요.">
  <a class="home" href="/">모든 아티클 보기</a>
</Page>

<style>
  .home {
    display: inline-flex;
    min-height: 3rem;
    align-items: center;
    padding: 0.75rem 1.5rem;
    border-radius: 3px;
    background: var(--night);
    color: var(--night-text);
    font-weight: 600;
    text-decoration: none;
  }
  .home:hover { background: #1d2a3d; }
</style>
