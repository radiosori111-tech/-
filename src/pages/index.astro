---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import DayBand from '../components/DayBand.astro';
import ArticleList from '../components/ArticleList.astro';
import Icon from '../components/Icon.astro';
import { CATEGORIES } from '../content.config';
import { SITE, minutesOfDay } from '../data/site';

const all = await getCollection('articles');
// 시각이 있는 글은 하루의 순서대로, '언제든' 글은 그 뒤에
const articles = all.sort((a, b) => (minutesOfDay(a.data.time) ?? 9999) - (minutesOfDay(b.data.time) ?? 9999));
const featured = articles.find((a) => a.data.featured) ?? articles[0];
const pins = articles
  .filter((a) => a.data.time)
  .map((a) => ({ slug: a.id, title: a.data.title, time: a.data.time!, moment: a.data.moment }));
const counts = Object.fromEntries(CATEGORIES.map((c) => [c, articles.filter((a) => a.data.category === c).length]));

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: SITE.name,
  description: SITE.description,
  inLanguage: 'ko',
  url: Astro.site?.toString(),
};
---
<Base jsonLd={jsonLd}>
  <section class="mast night">
    <div class="wrap">
      <div class="mast-grid">
        <div class="mast-copy">
          <h1>뇌를 이해하면,<br />하루가 바뀝니다</h1>
          <p class="slogan">{SITE.slogan}. 복잡한 뇌과학 연구를 쉽게 풀어, 오늘 바로 해볼 수 있는 행동으로 옮겨 적습니다.</p>
        </div>
        <article class="feature">
          <h2><a href={`/articles/${featured.id}/`}>{featured.data.title}</a></h2>
          <p class="feature-desc">{featured.data.description}</p>
          <p class="feature-time">
            <span class="time-mark">{featured.data.time ?? '언제든'}</span>
            <span>{featured.data.moment}</span>
            <span aria-hidden="true">·</span>
            <span class="tabular">{featured.data.readMinutes}분 읽기</span>
          </p>
          <a class="feature-go" href={`/articles/${featured.id}/`} aria-hidden="true" tabindex="-1">
            읽기 <Icon name="arrow-right" />
          </a>
        </article>
      </div>
      <DayBand pins={pins} />
    </div>
  </section>

  <section class="index wrap" aria-labelledby="index-title">
    <div class="index-head">
      <h2 id="index-title">모든 아티클</h2>
      <div class="filters" role="group" aria-label="카테고리로 거르기" data-filters>
        <button type="button" aria-pressed="true" data-filter="all">전체 <span class="tabular">{articles.length}</span></button>
        {CATEGORIES.map((c) => (
          <button type="button" aria-pressed="false" data-filter={c}>{c} <span class="tabular">{counts[c]}</span></button>
        ))}
      </div>
    </div>
    <ArticleList articles={articles} />
  </section>

  <section class="principles wrap" aria-labelledby="principles-title">
    <h2 id="principles-title">이곳의 글은 이렇게 씁니다</h2>
    <div class="principle-grid">
      <div>
        <h3>근거에서 출발합니다</h3>
        <p>모든 글은 학술지에 실린 연구나 학회의 공식 권고에서 출발하고, 글 끝에 참고 문헌을 밝힙니다. 확인할 수 없는 수치는 쓰지 않습니다.</p>
      </div>
      <div>
        <h3>쉽게, 그러나 정확하게</h3>
        <p>전문 용어는 풀어 쓰되, 연구가 말하지 않은 것까지 말하지 않습니다. 연구의 한계와 아직 논쟁 중인 부분도 함께 적습니다.</p>
      </div>
      <div>
        <h3>실행으로 끝맺습니다</h3>
        <p>읽고 끝나는 지식은 삶을 바꾸지 못합니다. 모든 글은 오늘 바로 해볼 수 있는 구체적인 행동, '오늘의 실행'으로 마무리합니다.</p>
      </div>
    </div>
    <a class="principles-more" href="/about/">사이트 소개 더 보기 <Icon name="arrow-right" /></a>
  </section>
</Base>

<script>
  const group = document.querySelector<HTMLElement>('[data-filters]');
  const rows = [...document.querySelectorAll<HTMLElement>('[data-rows] .row')];
  const empty = document.querySelector<HTMLElement>('[data-empty]');
  function apply(filter: string, push = true) {
    group?.querySelectorAll<HTMLButtonElement>('button').forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.filter === filter)));
    let shown = 0;
    rows.forEach((r) => {
      const on = filter === 'all' || r.dataset.category === filter;
      r.hidden = !on;
      if (on) shown++;
    });
    if (empty) empty.hidden = shown > 0;
    if (push) {
      const url = new URL(location.href);
      if (filter === 'all') url.searchParams.delete('c'); else url.searchParams.set('c', filter);
      history.replaceState(null, '', url);
    }
  }
  group?.addEventListener('click', (e) => {
    const btn = (e.target as HTMLElement).closest<HTMLButtonElement>('button[data-filter]');
    if (btn) apply(btn.dataset.filter!);
  });
  const initial = new URL(location.href).searchParams.get('c');
  if (initial && group?.querySelector(`[data-filter="${CSS.escape(initial)}"]`)) apply(initial, false);
</script>

<style>
  .mast { padding-top: clamp(3rem, 7vw, 5.5rem); }
  .mast-grid {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    gap: clamp(2.5rem, 6vw, 6rem);
    align-items: end;
  }
  h1 {
    font-family: var(--font-read);
    font-size: var(--step-5);
    font-weight: 600;
    line-height: 1.14;
    letter-spacing: -0.035em;
  }
  .slogan {
    margin-top: 1.75rem;
    max-width: 34rem;
    font-size: var(--step-1);
    line-height: 1.8;
    color: var(--night-muted);
  }
  .feature {
    position: relative;
    padding: 1.75rem 0 0.25rem 2rem;
    border-left: 1px solid var(--night-line);
  }
  .feature-time {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 1.25rem;
    font-size: 0.875rem;
    color: var(--night-muted);
  }
  .feature h2 {
    font-family: var(--font-read);
    font-size: var(--step-3);
    font-weight: 600;
    line-height: 1.38;
    letter-spacing: -0.025em;
  }
  .feature h2 a { text-decoration: none; }
  .feature h2 a::after { content: ''; position: absolute; inset: 0; }
  .feature-desc { margin-top: 0.875rem; color: var(--night-muted); line-height: 1.8; }
  .feature-go {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    margin-top: 1.25rem;
    font-weight: 600;
    color: var(--sun);
    text-decoration: none;
  }
  .feature-go .icon { transition: transform 0.4s var(--ease-out); }
  .feature:hover .feature-go .icon { transform: translateX(4px); }
  .feature:hover h2 a { text-decoration: underline; text-decoration-color: var(--sun); }

  .index { padding-top: clamp(3rem, 6vw, 5rem); }
  .index-head {
    display: flex;
    flex-wrap: wrap;
    align-items: end;
    justify-content: space-between;
    gap: 1.25rem 2rem;
    margin-bottom: 0;
  }
  .index-head h2 {
    margin-bottom: 1rem;
    font-family: var(--font-read);
    font-size: var(--step-4);
    font-weight: 600;
    letter-spacing: -0.03em;
    line-height: 1.2;
  }
  .filters { display: flex; flex-wrap: wrap; gap: 0 1.5rem; }
  .filters button {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    min-height: 2.75rem;
    padding: 0.5rem 0;
    border: 0;
    background: transparent;
    color: var(--ink-soft);
    font: inherit;
    font-size: 0.9375rem;
    font-weight: 500;
    cursor: pointer;
    transition: border-color 0.2s, background-color 0.2s, color 0.2s;
  }
  .filters button span { color: var(--muted); font-size: 0.8125rem; }
  .filters button::after {
    content: '';
    position: absolute;
    left: 0; right: 0; bottom: 0;
    height: 2px;
    background: var(--sun);
    transform: scaleX(0);
    transform-origin: left center;
    transition: transform 0.4s var(--ease-out);
  }
  .filters button:hover { color: var(--ink); }
  @media (max-width: 640px) {
    .index-head { flex-direction: column; align-items: stretch; gap: 0; }
    .filters { flex-wrap: nowrap; gap: 0 1.25rem; overflow-x: auto; min-width: 0; max-width: 100vw; scrollbar-width: none; margin-inline: calc(var(--gutter) * -1); padding-inline: var(--gutter); }
    .filters::-webkit-scrollbar { display: none; }
    .filters button { flex: none; white-space: nowrap; }
  }
  .filters button[aria-pressed='true'] { color: var(--ink); font-weight: 700; }
  .filters button[aria-pressed='true']::after { transform: scaleX(1); }
  .filters button[aria-pressed='true'] span { color: var(--sun-ink); }

  .principles { padding-top: clamp(4rem, 9vw, 7rem); }
  .principles > h2 {
    font-family: var(--font-read);
    font-size: var(--step-3);
    font-weight: 600;
    letter-spacing: -0.025em;
    padding-bottom: 1.25rem;
    border-bottom: 1px solid var(--ink);
  }
  .principle-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(1.5rem, 4vw, 3.5rem);
    padding-top: 1.75rem;
  }
  .principle-grid h3 { font-size: 1.0625rem; font-weight: 700; letter-spacing: -0.01em; }
  .principle-grid p { margin-top: 0.625rem; color: var(--muted); line-height: 1.8; }
  .principles-more {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    margin-top: 2rem;
    font-weight: 600;
    color: var(--sun-ink);
    text-decoration: none;
  }
  .principles-more:hover { text-decoration: underline; }

  @media (max-width: 900px) {
    .mast-grid { grid-template-columns: 1fr; }
    .feature { padding: 1.5rem 0 0; border-left: 0; border-top: 1px solid var(--night-line); }
    .principle-grid { grid-template-columns: 1fr; }
  }
</style>
