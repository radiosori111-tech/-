---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import DayBand from '../components/DayBand.astro';
import ArticleList from '../components/ArticleList.astro';
import Icon from '../components/Icon.astro';
import { CATEGORIES } from '../content.config';
import { SITE, minutesOfDay } from '../data/site';

const all = await getCollection('articles');
// 시각이 있는 글은 하루의 순서대로, '언제든' 글은 그 뒤에
const articles = all.sort((a, b) => (minutesOfDay(a.data.time) ?? 9999) - (minutesOfDay(b.data.time) ?? 9999));
const featured = articles.find((a) => a.data.featured) ?? articles[0];
const pins = articles
  .filter((a) => a.data.time)
  .map((a) => ({ slug: a.id, title: a.data.title, time: a.data.time!, moment: a.data.moment }));
const counts = Object.fromEntries(CATEGORIES.map((c) => [c, articles.filter((a) => a.data.category === c).length]));

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: SITE.name,
  description: SITE.description,
  inLanguage: 'ko',
  url: Astro.site?.toString(),
};
---
<Base jsonLd={jsonLd}>
  <section class="mast frame">
    <div class="wrap">
      <div class="mast-grid">
        <div class="mast-copy">
          <h1>뇌를 이해하면,<br /><span>하루가 바뀝니다</span></h1>
          <p class="slogan">{SITE.slogan}. 복잡한 뇌과학 연구를 쉽게 풀어, 오늘 바로 해볼 수 있는 행동으로 옮겨 적습니다.</p>
        </div>
        <article class="feature">
          <h2><a href={`/articles/${featured.id}/`}>{featured.data.title}</a></h2>
          <p class="feature-desc">{featured.data.description}</p>
          <div class="feature-foot">
            <p class="feature-time">
              <span class="time-mark">{featured.data.time ?? '언제든'}</span>
              <span>{featured.data.moment}</span>
              <span class="chip">{featured.data.category}</span>
              <span class="tabular">{featured.data.readMinutes}분 읽기</span>
            </p>
            <a class="feature-go" href={`/articles/${featured.id}/`} aria-hidden="true" tabindex="-1">
              읽기 <Icon name="arrow-right" />
            </a>
          </div>
        </article>
      </div>
      <DayBand pins={pins} />
    </div>
  </section>

  <section class="index wrap" aria-labelledby="index-title">
    <div class="index-head">
      <h2 id="index-title">모든 아티클</h2>
      <div class="filters-scroll">
        <div class="filters" role="group" aria-label="카테고리로 거르기" data-filters>
          <span class="filter-pill" data-pill aria-hidden="true"></span>
          <button type="button" aria-pressed="true" data-filter="all">전체 <span class="tabular">{articles.length}</span></button>
          {CATEGORIES.map((c) => (
            <button type="button" aria-pressed="false" data-filter={c}>{c} <span class="tabular">{counts[c]}</span></button>
          ))}
        </div>
      </div>
    </div>
    <ArticleList articles={articles} />
  </section>

  <section class="principles wrap" aria-labelledby="principles-title">
    <div class="principles-panel">
      <div class="principles-head">
        <h2 id="principles-title">이곳의 글은 이렇게 씁니다</h2>
        <a class="btn btn-secondary btn-sm" href="/about/">사이트 소개 더 보기 <Icon name="arrow-right" /></a>
      </div>
      <div class="principle-grid">
        <div>
          <h3>근거에서 출발합니다</h3>
          <p>모든 글은 학술지에 실린 연구나 학회의 공식 권고에서 출발하고, 글 끝에 참고 문헌을 밝힙니다. 확인할 수 없는 수치는 쓰지 않습니다.</p>
        </div>
        <div>
          <h3>쉽게, 그러나 정확하게</h3>
          <p>전문 용어는 풀어 쓰되, 연구가 말하지 않은 것까지 말하지 않습니다. 연구의 한계와 아직 논쟁 중인 부분도 함께 적습니다.</p>
        </div>
        <div>
          <h3>실행으로 끝맺습니다</h3>
          <p>읽고 끝나는 지식은 삶을 바꾸지 못합니다. 모든 글은 오늘 바로 해볼 수 있는 구체적인 행동, '오늘의 실행'으로 마무리합니다.</p>
        </div>
      </div>
    </div>
  </section>
</Base>

<script>
  const group = document.querySelector<HTMLElement>('[data-filters]');
  const pill = group?.querySelector<HTMLElement>('[data-pill]');
  const rows = [...document.querySelectorAll<HTMLElement>('[data-rows] .row')];
  const empty = document.querySelector<HTMLElement>('[data-empty]');
  const reduce = matchMedia('(prefers-reduced-motion: reduce)');

  // 선택된 칩 아래로 배경이 미끄러져 간다
  function movePill(animate: boolean) {
    const on = group?.querySelector<HTMLElement>('button[aria-pressed="true"]');
    if (!group || !pill || !on) return;
    pill.style.transition = animate && !reduce.matches ? '' : 'none';
    pill.style.width = `${on.offsetWidth}px`;
    pill.style.transform = `translateX(${on.offsetLeft}px)`;
    if (!animate) requestAnimationFrame(() => (pill.style.transition = ''));
  }

  function apply(filter: string, push = true) {
    group?.querySelectorAll<HTMLButtonElement>('button').forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.filter === filter)));
    movePill(push);
    let shown = 0;
    rows.forEach((r) => {
      const on = filter === 'all' || r.dataset.category === filter;
      r.hidden = !on;
      if (on) {
        if (push) {
          r.animate(
            reduce.matches
              ? [{ opacity: 0 }, { opacity: 1 }]
              : [{ opacity: 0, transform: 'translateY(8px)' }, { opacity: 1, transform: 'none' }],
            { duration: 240, delay: shown * 35, easing: 'cubic-bezier(0.23, 1, 0.32, 1)', fill: 'backwards' },
          );
        }
        shown++;
      }
    });
    if (empty) empty.hidden = shown > 0;
    if (push) {
      const url = new URL(location.href);
      if (filter === 'all') url.searchParams.delete('c'); else url.searchParams.set('c', filter);
      history.replaceState(null, '', url);
    }
  }
  group?.addEventListener('click', (e) => {
    const btn = (e.target as HTMLElement).closest<HTMLButtonElement>('button[data-filter]');
    if (btn && btn.getAttribute('aria-pressed') !== 'true') {
      apply(btn.dataset.filter!);
      btn.scrollIntoView({ block: 'nearest', inline: 'nearest', behavior: reduce.matches ? 'auto' : 'smooth' });
    }
  });
  const initial = new URL(location.href).searchParams.get('c');
  if (initial && group?.querySelector(`[data-filter="${CSS.escape(initial)}"]`)) apply(initial, false);
  movePill(false);
  document.fonts?.ready.then(() => movePill(false));
  addEventListener('resize', () => movePill(false));
</script>

<style>
  .mast { padding-top: clamp(3.5rem, 8vw, 6rem); }
  .mast-grid {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    gap: clamp(2.5rem, 6vw, 5rem);
    align-items: center;
  }
  h1 {
    font-size: var(--text-display);
    font-weight: 700;
    line-height: 1.2;
    letter-spacing: -0.04em;
  }
  h1 span { color: var(--accent-on-dark); }
  .slogan {
    margin-top: 1.5rem;
    max-width: 34rem;
    font-size: var(--text-lg);
    line-height: 1.75;
    color: var(--frame-muted);
  }

  .feature {
    position: relative;
    padding: 1.75rem;
    border: 1px solid var(--frame-line);
    border-radius: var(--radius-lg);
    background: var(--frame-raised);
    box-shadow: 0 24px 48px -24px rgb(0 0 0 / 0.5);
    transition: border-color 200ms ease, transform 240ms var(--ease-out);
  }
  .feature h2 {
    font-size: var(--text-2xl);
    font-weight: 700;
    line-height: 1.4;
    letter-spacing: -0.03em;
  }
  .feature h2 a { text-decoration: none; }
  .feature h2 a::after { content: ''; position: absolute; inset: 0; border-radius: inherit; }
  .feature-desc { margin-top: 0.75rem; color: var(--frame-muted); line-height: 1.75; font-size: var(--text-ui); }
  .feature-foot {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem 1rem;
    margin-top: 1.5rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--frame-line);
  }
  .feature-time { display: flex; flex-wrap: wrap; align-items: center; gap: 0.375rem 0.625rem; font-size: var(--text-sm); color: var(--frame-muted); }
  .feature-go {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    padding: 0.5rem 0.875rem;
    border-radius: var(--radius);
    background: var(--accent-on-dark);
    color: var(--frame);
    font-size: var(--text-sm);
    font-weight: 700;
    text-decoration: none;
  }
  .feature-go :global(.icon) { width: 1rem; height: 1rem; transition: transform 220ms var(--ease-out); }
  @media (hover: hover) and (pointer: fine) {
    .feature:hover { border-color: var(--frame-line-hover); }
  }
  @media (hover: hover) and (pointer: fine) and (prefers-reduced-motion: no-preference) {
    .feature:hover { transform: translateY(-2px); }
    .feature:hover .feature-go :global(.icon) { transform: translateX(3px); }
  }

  .index { padding-top: clamp(3.5rem, 7vw, 5.5rem); }
  .index-head {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1.25rem 2rem;
    margin-bottom: 1.75rem;
  }
  .index-head h2 {
    font-size: var(--text-3xl);
    font-weight: 700;
    letter-spacing: -0.035em;
    line-height: 1.25;
  }
  .filters-scroll { min-width: 0; max-width: 100%; }
  .filters {
    position: relative;
    display: inline-flex;
    gap: 0.125rem;
    padding: 0.25rem;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: var(--surface);
    box-shadow: var(--shadow-sm);
  }
  .filter-pill {
    position: absolute;
    left: 0; top: 0.25rem; bottom: 0.25rem;
    width: 0;
    border-radius: 999px;
    background: var(--frame);
    transition: transform 280ms var(--ease-in-out), width 280ms var(--ease-in-out);
  }
  .filters button {
    position: relative;
    z-index: 1;
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    min-height: 2.5rem;
    padding: 0.375rem 1rem;
    border: 0;
    border-radius: 999px;
    background: transparent;
    color: var(--ink-soft);
    font-size: var(--text-ui);
    font-weight: 500;
    white-space: nowrap;
    cursor: pointer;
    transition: color 200ms ease, background-color 150ms ease, transform 160ms var(--ease-out);
  }
  .filters button span { color: var(--muted); font-size: var(--text-xs); font-weight: 600; transition: color 200ms ease; }
  .filters button[aria-pressed='true'] { color: #fff; font-weight: 600; }
  .filters button[aria-pressed='true'] span { color: var(--accent-on-dark); }
  @media (hover: hover) and (pointer: fine) {
    .filters button[aria-pressed='false']:hover { color: var(--ink); background: var(--sunk); }
  }
  @media (prefers-reduced-motion: no-preference) {
    .filters button:active { transform: scale(0.96); }
  }

  .principles { padding-top: clamp(4rem, 9vw, 6.5rem); }
  .principles-panel {
    padding: clamp(1.75rem, 4vw, 2.75rem);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    background: var(--surface);
    box-shadow: var(--shadow-sm);
  }
  .principles-head {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem 2rem;
  }
  .principles-head h2 { font-size: var(--text-2xl); font-weight: 700; letter-spacing: -0.03em; }
  .principle-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    margin-top: 2rem;
    border-top: 1px solid var(--line);
  }
  .principle-grid > div { padding: 1.75rem 2rem 0.25rem 0; }
  .principle-grid > div + div { padding-left: 2rem; border-left: 1px solid var(--line); }
  .principle-grid h3 { font-size: var(--text-md); font-weight: 700; letter-spacing: -0.02em; }
  .principle-grid p { margin-top: 0.625rem; color: var(--muted); line-height: 1.8; font-size: var(--text-ui); }

  @media (max-width: 900px) {
    .mast-grid { grid-template-columns: 1fr; }
    .principle-grid { grid-template-columns: 1fr; }
    .principle-grid > div, .principle-grid > div + div { padding: 1.5rem 0 0; border-left: 0; }
    .principle-grid > div + div { margin-top: 1.5rem; border-top: 1px solid var(--line); }
  }
  @media (max-width: 640px) {
    .index-head { flex-direction: column; align-items: stretch; gap: 1rem; margin-bottom: 1.25rem; }
    .filters-scroll {
      overflow-x: auto;
      max-width: 100vw;
      margin-inline: calc(var(--gutter) * -1);
      padding: 0.25rem var(--gutter) 0.5rem;
      scroll-padding-inline: var(--gutter);
      scrollbar-width: none;
      mask-image: linear-gradient(90deg, transparent, #000 1rem, #000 calc(100% - 1rem), transparent);
    }
    .filters-scroll::-webkit-scrollbar { display: none; }
    .filters button { padding-inline: 0.875rem; }
    .feature { padding: 1.375rem; }
  }
</style>
