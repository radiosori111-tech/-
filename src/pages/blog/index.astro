---
import Page from '../../layouts/Page.astro';
import Icon from '../../components/Icon.astro';
import PostList, { type ListItem } from '../../components/PostList.astro';
import { getPosts, postUrl, postTags, postMinutes } from '../../data/blog';

const posts = await getPosts();
const items: ListItem[] = posts.map((p) => ({
  href: postUrl(p),
  key: `blog:${p.data.slug}`,
  title: p.data.title,
  description: p.data.description,
  minutes: postMinutes(p),
  image: p.data.image,
  date: p.data.date,
  hay: [p.data.title, p.data.description, ...postTags(p)].join(' ').toLowerCase(),
}));
---
<Page title="블로그" lede="뇌과학, 운동, 식단, 습관에 관해 그동안 블로그에 써 온 글을 한곳에 모았습니다.">
  <section aria-labelledby="list-title">
    <div class="list-head">
      <h2 id="list-title">모든 글 <span class="count tabular" aria-live="polite"><span data-count>{posts.length}</span>편</span></h2>
      <label class="search">
        <span class="visually-hidden">글 찾기</span>
        <Icon name="search" />
        <input type="search" placeholder="제목이나 주제로 찾기" title="예: BDNF, 러닝, 수면" autocomplete="off" enterkeyhint="search" data-search />
        <button type="button" class="search-clear" aria-label="검색어 지우기" data-clear hidden><Icon name="close" /></button>
      </label>
    </div>

    <PostList items={items} images lead />

    <div class="search-empty" data-search-empty hidden>
      <p><strong data-search-q></strong>에 맞는 글이 없어요.</p>
      <button type="button" class="btn btn-secondary btn-sm" data-clear>검색어 지우기</button>
    </div>
  </section>
</Page>

<script>
  const input = document.querySelector<HTMLInputElement>('[data-search]')!;
  const rows = [...document.querySelectorAll<HTMLElement>('[data-rows] .row')];
  const count = document.querySelector<HTMLElement>('[data-count]')!;
  const empty = document.querySelector<HTMLElement>('[data-search-empty]')!;
  const emptyQ = document.querySelector<HTMLElement>('[data-search-q]')!;
  const clearInline = document.querySelector<HTMLButtonElement>('.search-clear')!;

  function apply() {
    const words = input.value.trim().toLowerCase().split(/\s+/).filter(Boolean);
    let shown = 0;
    rows.forEach((row) => {
      const hit = words.every((w) => row.dataset.hay!.includes(w));
      row.hidden = !hit;
      if (hit) shown++;
    });
    // 검색 중에는 첫 글을 크게 보여 주지 않는다
    rows[0]?.classList.toggle('is-lead', words.length === 0);
    count.textContent = String(shown);
    clearInline.hidden = !input.value;
    empty.hidden = shown > 0;
    emptyQ.textContent = `‘${input.value.trim()}’`;
  }
  input.addEventListener('input', apply);
  document.querySelectorAll('[data-clear]').forEach((b) => b.addEventListener('click', () => {
    input.value = '';
    apply();
    input.focus();
  }));
  input.addEventListener('keydown', (e) => { if (e.key === 'Escape' && input.value) { input.value = ''; apply(); } });
  if (input.value) apply();
</script>

<style>
  .count { margin-left: 0.375rem; font-size: var(--text-md); font-weight: 600; letter-spacing: 0; color: var(--muted); }

  .search { position: relative; flex: 0 1 26rem; display: flex; align-items: center; }
  .search > :global(.icon) { position: absolute; left: 1rem; color: var(--muted); pointer-events: none; }
  .search input {
    width: 100%;
    min-height: 3rem;
    padding: 0.75rem 3rem 0.75rem 2.875rem;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: var(--surface);
    color: var(--ink);
    font: inherit;
    font-size: var(--text-ui);
    box-shadow: var(--shadow-sm);
    transition: border-color 150ms ease, box-shadow 200ms var(--ease-out);
  }
  .search input::placeholder { color: var(--placeholder); }
  .search input::-webkit-search-cancel-button { display: none; }
  .search input:hover { border-color: var(--line-hover); }
  .search input:focus { outline: none; border-color: var(--accent); box-shadow: 0 0 0 4px var(--accent-soft); }
  .search-clear {
    position: absolute;
    right: 0.375rem;
    display: grid;
    place-items: center;
    width: 2.25rem; height: 2.25rem;
    border: 0;
    border-radius: 999px;
    background: transparent;
    color: var(--muted);
    cursor: pointer;
    transition: background-color 150ms ease, color 150ms ease, transform 160ms var(--ease-out);
  }
  .search-clear:hover { background: var(--sunk); color: var(--ink); }
  .search-clear :global(.icon) { width: 1rem; height: 1rem; }
  @media (prefers-reduced-motion: no-preference) {
    .search-clear:active { transform: scale(0.92); }
  }

  .search-empty { display: grid; justify-items: center; gap: 1rem; padding: 4rem 1rem; text-align: center; color: var(--muted); }
  .search-empty strong { color: var(--ink); }

  @media (max-width: 640px) {
    .search { flex: 1 1 auto; }
  }
</style>
