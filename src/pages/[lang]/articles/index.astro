---
// 영어(/en/articles/) · 일본어(/ja/articles/) 아티클 목록. 한국어 목록은 /articles/이다.
import Page from '../../../layouts/Page.astro';
import PostList, { type ListItem } from '../../../components/PostList.astro';
import LangSwitch from '../../../components/LangSwitch.astro';
import HeadCard from '../../../components/HeadCard.astro';
import DayBand from '../../../components/DayBand.astro';
import { getArticles, articleUrl } from '../../../data/articles';
import { t, LANGS, DEFAULT_LANG, articlesPath, type Lang } from '../../../i18n/ui';

export function getStaticPaths() {
  return LANGS.filter((l) => l !== DEFAULT_LANG).map((lang) => ({ params: { lang } }));
}
const lang = Astro.params.lang as Lang;
const tr = t(lang);
const copy = {
  en: {
    title: 'Articles',
    heading: 'Brain science<br /><span>on the clock of your day</span>',
    lede: 'Brain science, explained plainly and placed on the clock of your day — each article ends with something you can do today.',
    all: 'All articles',
  },
  ja: {
    title: '記事',
    heading: '一日の時間に置いた<br /><span>脳科学</span>',
    lede: '脳科学をやさしく解きほぐし、一日のどの時間に実践するとよいかまで添えてお届けします。どの記事も、今日からできる行動で締めくくります。',
    all: 'すべての記事',
  },
}[lang as 'en' | 'ja'];

const articles = await getArticles(lang);
const items: ListItem[] = articles.map((a) => ({
  href: articleUrl(a),
  key: a.id,
  title: a.data.title,
  description: a.data.description,
  minutes: a.data.readMinutes,
  time: a.data.time ? { text: a.data.time, moment: a.data.moment } : { text: tr.post.anytime, anytime: true },
}));
const alternates = LANGS.map((l) => ({ lang: l, href: articlesPath(l) }));
const featured = articles.find((a) => a.data.featured) ?? articles[0];
const pins = articles
  .filter((a) => a.data.time)
  .map((a) => ({ href: articleUrl(a), title: a.data.title, time: a.data.time!, moment: a.data.moment }));
---
<Page title={copy.title} heading={copy.heading} lede={copy.lede} lang={lang} alternates={alternates}>
  <LangSwitch slot="head" alternates={alternates} current={lang} label={tr.post.readIn} />
  <HeadCard slot="feature" badge={tr.list.featured} href={articleUrl(featured)} title={featured.data.title} description={featured.data.description} readLabel={tr.list.read}>
    <span class="time-mark">{featured.data.time ?? tr.post.anytime}</span>
    {featured.data.time && <span>{featured.data.moment}</span>}
    <span>{tr.post.minutes(featured.data.readMinutes)}</span>
  </HeadCard>
  <DayBand slot="band" pins={pins} lang={lang} />
  <section aria-labelledby="list-title">
    <div class="list-head">
      <h2 id="list-title">{copy.all} <span class="count tabular">{tr.list.count(String(items.length))}</span></h2>
    </div>
    <PostList items={items} lang={lang} />
  </section>
</Page>

<style>
  .count { margin-left: 0.375rem; font-size: var(--text-md); font-weight: 600; letter-spacing: 0; color: var(--muted); }
</style>
