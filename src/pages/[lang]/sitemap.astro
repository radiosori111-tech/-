---
import SitemapPage from '../../components/pages/SitemapPage.astro';
import { LANGS, DEFAULT_LANG, type Lang } from '../../i18n/ui';

export function getStaticPaths() {
  return LANGS.filter((l) => l !== DEFAULT_LANG).map((lang) => ({ params: { lang } }));
}
---
<SitemapPage lang={Astro.params.lang as Lang} />
