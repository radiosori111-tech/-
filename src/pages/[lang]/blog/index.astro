---
// 영어(/en/blog/) · 일본어(/ja/blog/) 블로그 목록
import BlogIndex from '../../../components/blog/BlogIndex.astro';
import { LANGS, DEFAULT_LANG, type Lang } from '../../../i18n/ui';

export function getStaticPaths() {
  return LANGS.filter((l) => l !== DEFAULT_LANG).map((lang) => ({ params: { lang } }));
}
const lang = Astro.params.lang as Lang;
---
<BlogIndex lang={lang} />
