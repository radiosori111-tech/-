---
import ConceptPage from '../../../components/knowledge/ConceptPage.astro';
import { CONCEPTS } from '../../../data/concepts';
import { LANGS, DEFAULT_LANG, type Lang } from '../../../i18n/ui';

export function getStaticPaths() {
  return LANGS.filter((l) => l !== DEFAULT_LANG).flatMap((lang) => CONCEPTS.map((c) => ({ params: { lang, id: c.id } })));
}
---
<ConceptPage lang={Astro.params.lang as Lang} id={Astro.params.id} />
