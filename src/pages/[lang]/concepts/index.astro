---
import ConceptPage from '../../../components/knowledge/ConceptPage.astro';
import { LANGS, DEFAULT_LANG, type Lang } from '../../../i18n/ui';

export function getStaticPaths() {
  return LANGS.filter((l) => l !== DEFAULT_LANG).map((lang) => ({ params: { lang } }));
}
---
<ConceptPage lang={Astro.params.lang as Lang} />
