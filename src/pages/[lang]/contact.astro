---
import ContactPage from '../../components/pages/ContactPage.astro';
import { LANGS, DEFAULT_LANG, type Lang } from '../../i18n/ui';

export function getStaticPaths() {
  return LANGS.filter((l) => l !== DEFAULT_LANG).map((lang) => ({ params: { lang } }));
}
---
<ContactPage lang={Astro.params.lang as Lang} />
