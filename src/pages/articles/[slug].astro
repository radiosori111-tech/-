---
import ArticlePost from '../../components/articles/ArticlePost.astro';
import { getArticles } from '../../data/articles';

export async function getStaticPaths() {
  const ordered = await getArticles('ko');
  return ordered.map((entry, i) => ({
    params: { slug: entry.id },
    props: {
      entry,
      prev: ordered[i - 1] ?? null,
      next: ordered[i + 1] ?? null,
      related: [...ordered.slice(i + 2), ...ordered.slice(0, Math.max(0, i - 1))].slice(0, 2),
    },
  }));
}
---
<ArticlePost {...Astro.props} />
