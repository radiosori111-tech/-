---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import DayBand from '../../components/DayBand.astro';
import HeroBrain from '../../components/HeroBrain.astro';
import HeadCard from '../../components/HeadCard.astro';
import PostList, { type ListItem } from '../../components/PostList.astro';
import Icon from '../../components/Icon.astro';
import { SITE, minutesOfDay } from '../../data/site';
import { LANGS, articlesPath } from '../../i18n/ui';

const all = await getCollection('articles', (a) => a.data.lang === 'ko');
// 시각이 있는 글은 하루의 순서대로, '언제든' 글은 그 뒤에
const articles = all.sort((a, b) => (minutesOfDay(a.data.time) ?? 9999) - (minutesOfDay(b.data.time) ?? 9999));
const featured = articles.find((a) => a.data.featured) ?? articles[0];
const pins = articles
  .filter((a) => a.data.time)
  .map((a) => ({ href: `/articles/${a.id}/`, title: a.data.title, time: a.data.time!, moment: a.data.moment }));
const items: ListItem[] = articles.map((a) => ({
  href: `/articles/${a.id}/`,
  key: a.id,
  title: a.data.title,
  description: a.data.description,
  minutes: a.data.readMinutes,
  time: a.data.time ? { text: a.data.time, moment: a.data.moment } : { text: '언제든', anytime: true },
}));

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: SITE.name,
  description: SITE.description,
  inLanguage: 'ko',
  url: Astro.site?.toString(),
};
---
<Base jsonLd={jsonLd} alternates={LANGS.map((lang) => ({ lang, href: articlesPath(lang) }))}>
  <section class="mast frame">
    <HeroBrain lang="ko" />
    <div class="wrap">
      <div class="mast-grid">
        <div class="mast-copy">
          <h1>뇌를 이해하면,<br /><span>하루가 바뀝니다</span></h1>
          <p class="slogan">{SITE.slogan}. 복잡한 뇌과학 연구를 쉽게 풀어, 오늘 바로 해볼 수 있는 행동으로 옮겨 적습니다.</p>
        </div>
        <HeadCard badge="추천 아티클" href={`/articles/${featured.id}/`} title={featured.data.title} description={featured.data.description} readLabel="읽기">
          <span class="time-mark">{featured.data.time ?? '언제든'}</span>
          <span>{featured.data.moment}</span>
          <span>{featured.data.readMinutes}분 읽기</span>
        </HeadCard>
      </div>
      <DayBand pins={pins} lang="ko" />
    </div>
  </section>

  <section class="index wrap" aria-labelledby="index-title">
    <div class="list-head">
      <h2 id="index-title">모든 아티클</h2>
    </div>
    <PostList items={items} />
  </section>

  <section class="principles wrap" aria-labelledby="principles-title">
    <div class="principles-panel">
      <div class="principles-head">
        <h2 id="principles-title">이곳의 글은 이렇게 씁니다</h2>
        <a class="btn btn-secondary btn-sm" href="/about/">사이트 소개 더 보기 <Icon name="arrow-right" /></a>
      </div>
      <div class="principle-grid">
        <div>
          <h3>근거에서 출발합니다</h3>
          <p>모든 글은 학술지에 실린 연구나 학회의 공식 권고에서 출발하고, 글 끝에 참고 문헌을 밝힙니다. 확인할 수 없는 수치는 쓰지 않습니다.</p>
        </div>
        <div>
          <h3>쉽게, 그러나 정확하게</h3>
          <p>전문 용어는 풀어 쓰되, 연구가 말하지 않은 것까지 말하지 않습니다. 연구의 한계와 아직 논쟁 중인 부분도 함께 적습니다.</p>
        </div>
        <div>
          <h3>실행으로 끝맺습니다</h3>
          <p>읽고 끝나는 지식은 삶을 바꾸지 못합니다. 모든 글은 오늘 바로 해볼 수 있는 구체적인 행동, '오늘의 실행'으로 마무리합니다.</p>
        </div>
      </div>
    </div>
  </section>
</Base>

<style>
  .mast { padding-top: clamp(3.5rem, 8vw, 6rem); }
  .mast-grid {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    gap: clamp(2.5rem, 6vw, 5rem);
    align-items: center;
  }
  h1 {
    font-size: var(--text-display);
    font-weight: 700;
    line-height: 1.2;
    letter-spacing: -0.04em;
  }
  h1 span { color: var(--accent-on-dark); }
  .slogan {
    margin-top: 1.5rem;
    max-width: 34rem;
    font-size: var(--text-lg);
    line-height: 1.75;
    color: var(--frame-muted);
  }

  .index { padding-top: clamp(3.5rem, 7vw, 5.5rem); }

  .principles { padding-top: clamp(4rem, 9vw, 6.5rem); }
  .principles-panel {
    padding: clamp(1.75rem, 4vw, 2.75rem);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    background: var(--surface);
    box-shadow: var(--shadow-sm);
  }
  .principles-head {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem 2rem;
  }
  .principles-head h2 { font-size: var(--text-2xl); font-weight: 700; letter-spacing: -0.03em; }
  .principle-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    margin-top: 2rem;
    border-top: 1px solid var(--line);
  }
  .principle-grid > div { padding: 1.75rem 2rem 0.25rem 0; }
  .principle-grid > div + div { padding-left: 2rem; border-left: 1px solid var(--line); }
  .principle-grid h3 { font-size: var(--text-md); font-weight: 700; letter-spacing: -0.02em; }
  .principle-grid p { margin-top: 0.625rem; color: var(--muted); line-height: 1.8; font-size: var(--text-ui); }

  @media (max-width: 900px) {
    .mast-grid { grid-template-columns: 1fr; }
    .principle-grid { grid-template-columns: 1fr; }
    .principle-grid > div, .principle-grid > div + div { padding: 1.5rem 0 0; border-left: 0; }
    .principle-grid > div + div { margin-top: 1.5rem; border-top: 1px solid var(--line); }
  }
</style>
