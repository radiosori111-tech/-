---
import Base from './Base.astro';

interface Props { title: string; lede: string; description?: string }
const { title, lede, description } = Astro.props;
---
<Base title={title} description={description ?? lede}>
  <header class="page-head night">
    <div class="wrap">
      <h1>{title}</h1>
      <p class="lede">{lede}</p>
      <div class="scale tabular" aria-hidden="true">
        {[0, 3, 6, 9, 12, 15, 18, 21, 24].map((h) => <span style={`left:${(h / 24) * 100}%`}>{String(h).padStart(2, '0')}</span>)}
      </div>
    </div>
  </header>
  <div class="wrap page-body">
    <slot />
  </div>
</Base>

<style>
  .page-head { padding-block: clamp(2.75rem, 7vw, 5rem) 1.25rem; }
  .page-head h1 {
    font-family: var(--font-read);
    font-size: var(--step-5);
    font-weight: 600;
    line-height: 1.15;
    letter-spacing: -0.035em;
  }
  .lede {
    margin-top: 1.25rem;
    max-width: 40rem;
    font-size: var(--step-1);
    line-height: 1.8;
    color: var(--night-muted);
  }
  .scale {
    position: relative;
    height: 1.75rem;
    margin-top: clamp(2.5rem, 6vw, 3.5rem);
    border-top: 1px solid var(--night-line);
    font-size: 0.75rem;
    color: var(--night-faint);
  }
  .scale span { position: absolute; top: 0.5rem; transform: translateX(-50%); }
  .scale span::before { content: ''; position: absolute; left: 50%; top: calc(-0.5rem - 5px); width: 1px; height: 9px; background: var(--night-line); }
  .scale span:first-child { transform: none; }
  .scale span:first-child::before { left: 0; }
  .scale span:last-child { transform: translateX(-100%); }
  .scale span:last-child::before { left: auto; right: 0; }
  @media (max-width: 720px) { .scale span:nth-child(even) { display: none; } }
  .page-body { padding-top: clamp(2.5rem, 6vw, 4.5rem); }

  /* 소개·문의·정책 페이지의 본문 */
  .page-body :global(.doc) { max-width: var(--measure); font-family: var(--font-read); font-size: 1.125rem; line-height: 1.9; }
  .page-body :global(.doc h2) {
    margin: 2.75em 0 0.8em;
    font-size: 1.5rem;
    font-weight: 600;
    line-height: 1.4;
    letter-spacing: -0.025em;
  }
  .page-body :global(.doc h2:first-child) { margin-top: 0; }
  .page-body :global(.doc h3) { margin: 1.75em 0 0.5em; font-family: var(--font-ui); font-size: 1.0625rem; font-weight: 700; }
  .page-body :global(.doc p) { margin-bottom: 1.25em; }
  .page-body :global(.doc ul), .page-body :global(.doc ol) { margin: 0 0 1.25em; padding-left: 1.4em; }
  .page-body :global(.doc li) { margin-bottom: 0.5em; }
  .page-body :global(.doc li::marker) { color: var(--sun-ink); }
  .page-body :global(.doc a) { text-decoration-color: var(--sun); }
  .page-body :global(.doc strong) { font-weight: 650; }

  @media (max-width: 640px) {
    .page-body :global(.doc) { font-size: 1.0625rem; }
    .page-body :global(.doc h2) { font-size: 1.375rem; }
  }
</style>
