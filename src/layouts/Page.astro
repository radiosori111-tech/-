---
import Base from './Base.astro';
import HeroBrain from '../components/HeroBrain.astro';
import { DEFAULT_LANG, type Lang, type Alternate } from '../i18n/ui';

// heading을 주면 화면의 큰 제목은 그 HTML로 쓰고(<span>은 강조색), 문서 제목(title)은 그대로 둔다. title이 null이면 사이트 이름이 문서 제목이 된다
interface Props { title: string | null; heading?: string; lede: string; description?: string; lang?: Lang; alternates?: Alternate[] }
const { title, heading, lede, description, lang = DEFAULT_LANG, alternates } = Astro.props;
const hasFeature = Astro.slots.has('feature');
---
<Base title={title ?? undefined} description={description ?? lede} lang={lang} alternates={alternates}>
  <header class:list={['page-head frame', hasFeature && 'has-feature']}>
    <HeroBrain lang={lang} />
    <div class="wrap">
      <div class="head-grid">
        <div class="head-copy">
          {heading ? <h1 set:html={heading} /> : <h1>{title}</h1>}
          <p class="lede">{lede}</p>
          <slot name="head" />
        </div>
        {hasFeature && <slot name="feature" />}
      </div>
      <slot name="band" />
    </div>
  </header>
  <div class="wrap page-body">
    <slot />
  </div>
</Base>

<style>
  .page-head { padding-block: clamp(3rem, 7vw, 5rem) clamp(2.75rem, 6vw, 4.25rem); }
  .page-head h1 :global(span) { color: var(--accent-on-dark); }
  .page-head h1 {
    font-size: var(--text-display);
    font-weight: 700;
    line-height: 1.2;
    letter-spacing: -0.035em;
  }
  .lede {
    margin-top: 1.125rem;
    max-width: 42rem;
    font-size: var(--text-lg);
    line-height: 1.75;
    color: var(--frame-muted);
  }
  .page-body { padding-top: clamp(2.75rem, 6vw, 4.5rem); }

  /* 오른쪽 카드가 있는 머리(블로그): 아티클 홈 머리와 같은 높이와 7:5 배치 */
  .has-feature { padding-block: clamp(3.5rem, 8vw, 6rem) clamp(2.5rem, 5vw, 4rem); }
  .has-feature:has(.dayband) { padding-bottom: 0; }
  .has-feature .head-grid {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    gap: clamp(2.5rem, 6vw, 5rem);
    align-items: center;
  }
  .has-feature .lede { max-width: 34rem; margin-top: 1.5rem; }
  @media (max-width: 900px) { .has-feature .head-grid { grid-template-columns: minmax(0, 1fr); } }

  /* 모바일 블로그 홈: 첫 화면에 뇌와 '지금' 선이 보이도록, 하루 띠를 최신글 카드 위로 올리고 뇌를 제목 뒤쪽 위에 둔다 */
  @media (max-width: 900px) {
    .has-feature .wrap { display: flex; flex-direction: column; }
    .has-feature .head-grid { display: contents; }
    .has-feature .head-copy { order: 1; }
    .has-feature .wrap > :global(.dayband) { order: 2; margin-top: 2rem; padding-bottom: 0.5rem; }
    .has-feature .head-grid > :global(:not(.head-copy)) { order: 3; margin-top: 1.75rem; }
    .page-head.has-feature:has(:global(.dayband)) { padding-bottom: clamp(2.5rem, 5vw, 4rem); }
    .page-head.has-feature :global(.hero-brain) {
      top: 0.5rem;
      left: auto;
      right: -5.5rem;
      translate: none;
      width: min(26rem, 92vw);
      opacity: 0.55;
    }
  }

  /* 소개 · 문의 · 정책 페이지의 본문 */
  .page-body :global(.doc) { max-width: var(--measure); font-size: var(--text-md); line-height: 1.85; color: var(--ink-soft); }
  .page-body :global(.doc h2) {
    margin: 2.5em 0 0.75em;
    font-size: var(--text-2xl);
    font-weight: 700;
    line-height: 1.4;
    letter-spacing: -0.03em;
    color: var(--ink);
  }
  .page-body :global(.doc h2:first-child) { margin-top: 0; }
  .page-body :global(.doc h3) { margin: 1.75em 0 0.5em; font-size: var(--text-md); font-weight: 700; color: var(--ink); }
  .page-body :global(.doc p) { margin-bottom: 1.25em; }
  .page-body :global(.doc ul), .page-body :global(.doc ol) { margin: 0 0 1.25em; padding-left: 1.4em; }
  .page-body :global(.doc li) { margin-bottom: 0.5em; padding-left: 0.2em; }
  .page-body :global(.doc li::marker) { color: var(--accent); font-weight: 600; }
  .page-body :global(.doc a) { color: var(--accent-strong); font-weight: 500; }
  .page-body :global(.doc a:hover) { color: var(--accent); }
  .page-body :global(.doc strong) { font-weight: 650; color: var(--ink); }

  @media (max-width: 640px) {
    .page-body :global(.doc) { font-size: 1rem; }
  }
</style>
