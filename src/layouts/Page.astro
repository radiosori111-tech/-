---
import Base from './Base.astro';
import HeroBrain from '../components/HeroBrain.astro';
import { DEFAULT_LANG, type Lang, type Alternate } from '../i18n/ui';

interface Props { title: string; lede: string; description?: string; lang?: Lang; alternates?: Alternate[] }
const { title, lede, description, lang = DEFAULT_LANG, alternates } = Astro.props;
---
<Base title={title} description={description ?? lede} lang={lang} alternates={alternates}>
  <header class="page-head frame">
    <HeroBrain lang={lang} />
    <div class="wrap">
      <h1>{title}</h1>
      <p class="lede">{lede}</p>
      <slot name="head" />
    </div>
  </header>
  <div class="wrap page-body">
    <slot />
  </div>
</Base>

<style>
  .page-head { padding-block: clamp(3rem, 7vw, 5rem) clamp(2.75rem, 6vw, 4.25rem); }
  .page-head h1 {
    font-size: var(--text-display);
    font-weight: 700;
    line-height: 1.2;
    letter-spacing: -0.035em;
  }
  .lede {
    margin-top: 1.125rem;
    max-width: 42rem;
    font-size: var(--text-lg);
    line-height: 1.75;
    color: var(--frame-muted);
  }
  .page-body { padding-top: clamp(2.75rem, 6vw, 4.5rem); }

  /* 소개 · 문의 · 정책 페이지의 본문 */
  .page-body :global(.doc) { max-width: var(--measure); font-size: var(--text-md); line-height: 1.85; color: var(--ink-soft); }
  .page-body :global(.doc h2) {
    margin: 2.5em 0 0.75em;
    font-size: var(--text-2xl);
    font-weight: 700;
    line-height: 1.4;
    letter-spacing: -0.03em;
    color: var(--ink);
  }
  .page-body :global(.doc h2:first-child) { margin-top: 0; }
  .page-body :global(.doc h3) { margin: 1.75em 0 0.5em; font-size: var(--text-md); font-weight: 700; color: var(--ink); }
  .page-body :global(.doc p) { margin-bottom: 1.25em; }
  .page-body :global(.doc ul), .page-body :global(.doc ol) { margin: 0 0 1.25em; padding-left: 1.4em; }
  .page-body :global(.doc li) { margin-bottom: 0.5em; padding-left: 0.2em; }
  .page-body :global(.doc li::marker) { color: var(--accent); font-weight: 600; }
  .page-body :global(.doc a) { color: var(--accent-strong); font-weight: 500; }
  .page-body :global(.doc a:hover) { color: var(--accent); }
  .page-body :global(.doc strong) { font-weight: 650; color: var(--ink); }

  @media (max-width: 640px) {
    .page-body :global(.doc) { font-size: 1rem; }
  }
</style>
