---
import 'pretendard/dist/web/variable/pretendardvariable-dynamic-subset.css';
import '../styles/global.css';
import Icon from '../components/Icon.astro';
import LangSwitch from '../components/LangSwitch.astro';
import AdSenseHead from '../components/ads/AdSenseHead.astro';
import { SITE, seoulParts } from '../data/site';
import { t, LANGS, blogPath, homePath, articlesPath, pagePath, OG_LOCALE, HREFLANG, DEFAULT_LANG, type Lang, type Alternate } from '../i18n/ui';

interface Props {
  title?: string;
  description?: string;
  type?: 'website' | 'article';
  jsonLd?: Record<string, unknown>;
  image?: string;
  lang?: Lang;
  // 같은 내용의 다른 언어 페이지들 (자기 자신 포함). 두 개 이상일 때 hreflang 태그를 넣는다
  alternates?: Alternate[];
  // 검색 결과에 넣지 않을 페이지 (404 등)
  noindex?: boolean;
}

const { title, type = 'website', jsonLd, image, lang = DEFAULT_LANG, alternates = [], noindex = false } = Astro.props;
const tr = t(lang);
const description = Astro.props.description ?? tr.description;
const slogan = tr.slogan;
const fullTitle = title ? `${title} | ${SITE.name}` : `${SITE.name} — ${slogan}`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const path = Astro.url.pathname;
const articlesHref = articlesPath(lang);
const homeHref = homePath(lang);
// 블로그 메뉴는 첫 화면과 블로그 글에서, 아티클 메뉴는 아티클 목록과 글에서 켜진다
const isCurrent = (href: string) =>
  href === homeHref ? path === homeHref || path.startsWith(blogPath(lang))
  : path.startsWith(href);
// 메뉴 · 푸터 링크는 지금 보고 있는 언어의 페이지로 간다
const nav = [
  { href: homeHref, label: tr.nav.blog },
  { href: articlesHref, label: tr.nav.articles },
  { href: pagePath(lang, '/about/'), label: tr.nav.about },
  { href: pagePath(lang, '/contact/'), label: tr.nav.contact },
];
const privacyHref = pagePath(lang, '/privacy/');
// 머리 메뉴의 언어 탭: 같은 페이지의 번역이 있으면 그리로, 없으면 그 언어의 아티클 홈으로 간다
const langLinks = LANGS.map((l) => alternates.find((a) => a.lang === l) ?? { lang: l, href: homePath(l) });
const abs = (href: string) => new URL(href, Astro.site).toString();
// 글에 대표 이미지가 없으면 사이트 기본 이미지(1200×630)를 공유 미리보기에 쓴다. 크기는 기본 이미지일 때만 적는다
const ogImage = image ?? SITE.ogImage;
---
<!doctype html>
<html lang={HREFLANG[lang]}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <!-- 저장해 둔 화면 모드를 그리기 전에 적용해 깜빡임을 막는다 -->
    <script is:inline>try { const m = localStorage.getItem('mgs:theme'); if (m === 'dark' || m === 'light') document.documentElement.dataset.theme = m; } catch {}</script>
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="google-site-verification" content="zxZW0YclDH3R_GsIjoLKVRfqxiPKT_ZzV8YWoU35YPc" />
    {noindex && <meta name="robots" content="noindex, follow" />}
    {!noindex && <link rel="canonical" href={canonical} />}
    {/* noindex 페이지는 canonical처럼 언어별 주소(hreflang)도 넣지 않는다 */}
    {!noindex && alternates.length > 1 && (
      <>
        {alternates.map((a) => <link rel="alternate" hreflang={HREFLANG[a.lang]} href={abs(a.href)} />)}
        <link rel="alternate" hreflang="x-default" href={abs((alternates.find((a) => a.lang === DEFAULT_LANG) ?? alternates[0]).href)} />
      </>
    )}
    <link rel="alternate" type="application/rss+xml" title={SITE.name} href={new URL("rss.xml", Astro.site)} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="theme-color" content="#0f141c" />
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={title ?? SITE.name} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={OG_LOCALE[lang]} />
    {alternates.filter((a) => a.lang !== lang).map((a) => <meta property="og:locale:alternate" content={OG_LOCALE[a.lang]} />)}
    <meta property="og:image" content={new URL(ogImage, Astro.site)} />
    {!image && (
      <>
        <meta property="og:image:width" content="1200" />
        <meta property="og:image:height" content="630" />
      </>
    )}
    <meta name="twitter:card" content="summary_large_image" />
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
    {/* 구글 애널리틱스 · 애드센스: ID가 있을 때, 배포용 빌드에서만 불러온다 */}
    {import.meta.env.PROD && SITE.gaId && (
      <>
        <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${SITE.gaId}`}></script>
        <script is:inline define:vars={{ gaId: SITE.gaId }}>
          window.dataLayer = window.dataLayer || [];
          window.gtag = function () { dataLayer.push(arguments); };
          gtag('js', new Date());
          gtag('config', gaId);
        </script>
      </>
    )}
    <AdSenseHead />
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#main">{tr.skip}</a>
    <header class="site-header frame">
      <div class="wrap bar">
        <a class="brand" href={homeHref} aria-label={`${SITE.name} ${tr.home}`}>
          <svg class="brand-mark" viewBox="0 0 28 28" aria-hidden="true">
            <rect width="28" height="28" rx="8" />
            <path d="M8 18.5c2.5-9 9.5 0 12-9" />
            <circle cx="8" cy="18.5" r="2.25" />
            <circle cx="20" cy="9.5" r="2.25" />
          </svg>
          <span>믿음의 게임, <b>실행</b></span>
        </a>
        <nav aria-label={tr.mainMenu}>
          <ul>
            {nav.map((item) => (
              <li><a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>{item.label}</a></li>
            ))}
          </ul>
        </nav>
        <div class="bar-lang">
          <button type="button" class="theme-toggle" data-theme-toggle data-label-dark={tr.theme.toDark} data-label-light={tr.theme.toLight} aria-label={tr.theme.toDark}>
            <span class="theme-moon"><Icon name="moon" /></span>
            <span class="theme-sun"><Icon name="sun" /></span>
          </button>
          <LangSwitch alternates={langLinks} current={lang} label={tr.langMenu} compact />
        </div>
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="site-footer frame">
      <div class="wrap foot">
        <div class="foot-top">
          <div class="foot-brand">
            <p class="foot-name">믿음의 게임, 실행</p>
            <p class="foot-slogan">{slogan}</p>
          </div>
          <nav class="foot-links" aria-label={tr.foot.label}>
            <a href={pagePath(lang, '/about/')}>{tr.nav.about}</a>
            <a href={pagePath(lang, '/contact/')}>{tr.nav.contact}</a>
            <a href={privacyHref}>{tr.foot.privacy}</a>
            <a href={privacyHref + '#disclaimer'}>{tr.foot.disclaimer}</a>
            <a href={pagePath(lang, '/concepts/')}>{tr.foot.concepts}</a>
          </nav>
          <div class="foot-meta">
            <p>{tr.foot.email} <a href={`mailto:${SITE.email}`}>{SITE.email}</a></p>
          </div>
        </div>
        <div class="foot-bottom">
          <p class="foot-copy tabular">© {seoulParts(new Date()).y} 믿음의 게임, 실행</p>
          <div class="foot-license">
            <a class="cc-mark" href={tr.foot.licenseUrl} rel="license noopener" target="_blank" aria-label={tr.foot.licenseLabel} title={tr.foot.licenseLabel}>
              <!-- 크리에이티브 커먼즈 표시: CC · 저작자표시(BY) · 비영리(NC) · 변경금지(ND) -->
              <svg viewBox="0 0 120 30" aria-hidden="true">
                <g fill="none" stroke="currentColor" stroke-width="2">
                  <circle cx="15" cy="15" r="12"/><circle cx="45" cy="15" r="12"/><circle cx="75" cy="15" r="12"/><circle cx="105" cy="15" r="12"/>
                </g>
                <text x="15" y="19.5" text-anchor="middle" font-size="12" font-weight="700" fill="currentColor" font-family="Arial, sans-serif">cc</text>
                <circle cx="45" cy="9" r="2.6" fill="currentColor"/>
                <path d="M41.5 13.5h7v6h-2v5h-3v-5h-2z" fill="currentColor"/>
                <text x="75" y="19.5" text-anchor="middle" font-size="12" font-weight="700" fill="currentColor" font-family="Arial, sans-serif">$</text>
                <path d="M66.5 6.5l17 17" stroke="currentColor" stroke-width="2"/>
                <path d="M99 12h12M99 18h12" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"/>
              </svg>
              <span>BY-NC-ND 4.0</span>
            </a>
            <p class="foot-license-text" set:html={tr.foot.license} />
          </div>
        </div>
      </div>
    </footer>

    <div class="toast" data-toast role="status" aria-live="polite"><Icon name="check" /><span data-toast-text></span></div>

    <script>
      // 어디서든 document.dispatchEvent(new CustomEvent('toast', { detail: '문구' }))로 띄운다.
      const toast = document.querySelector<HTMLElement>('[data-toast]');
      const text = toast?.querySelector<HTMLElement>('[data-toast-text]');
      let timer = 0;
      document.addEventListener('toast', (e) => {
        if (!toast || !text) return;
        text.textContent = String((e as CustomEvent).detail ?? '');
        toast.classList.add('is-on');
        clearTimeout(timer);
        timer = window.setTimeout(() => toast.classList.remove('is-on'), 2200);
      });
    </script>
    <script>
      // 화면 모드 전환: 지금 보이는 모드의 반대로 바꾸고 기억해 둔다
      const toggle = document.querySelector<HTMLButtonElement>('[data-theme-toggle]');
      const root = document.documentElement;
      const isDark = () => (root.dataset.theme ? root.dataset.theme === 'dark' : matchMedia('(prefers-color-scheme: dark)').matches);
      const label = () => toggle?.setAttribute('aria-label', isDark() ? toggle.dataset.labelLight! : toggle.dataset.labelDark!);
      label();
      toggle?.addEventListener('click', () => {
        const next = isDark() ? 'light' : 'dark';
        root.dataset.theme = next;
        try { localStorage.setItem('mgs:theme', next); } catch {}
        label();
      });
    </script>
  </body>
</html>

<style>
  .site-header { position: relative; z-index: 5; border-bottom: 1px solid var(--frame-line); }
  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    min-height: 4.25rem;
  }
  .brand { margin-right: auto; }
  /* 메뉴와 언어 탭 사이를 얇은 세로선으로 나눈다 */
  .bar-lang { display: flex; align-items: center; gap: 0.75rem; padding-left: 1.5rem; border-left: 1px solid var(--frame-line); }
  .theme-toggle {
    flex: none;
    display: grid;
    place-items: center;
    width: 2.375rem; height: 2.375rem;
    border: 1px solid var(--frame-line);
    border-radius: 999px;
    background: var(--frame-raised);
    color: var(--frame-muted);
    cursor: pointer;
    transition: color 150ms ease, border-color 150ms ease;
  }
  .theme-toggle:hover { color: var(--frame-text); border-color: var(--frame-line-hover); }
  .theme-toggle:focus-visible { outline: 2px solid var(--accent-on-dark); outline-offset: 2px; }
  .theme-toggle :global(.icon) { width: 1.125rem; height: 1.125rem; }
  .theme-sun { display: none; }
  :global(:root[data-theme='dark']) .theme-moon { display: none; }
  :global(:root[data-theme='dark']) .theme-sun { display: contents; }
  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme='light'])) .theme-moon { display: none; }
    :global(:root:not([data-theme='light'])) .theme-sun { display: contents; }
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.625rem;
    text-decoration: none;
    font-weight: 700;
    font-size: 1.0625rem;
    letter-spacing: -0.03em;
    border-radius: var(--radius-sm);
  }
  .brand b { color: var(--accent-on-dark); font-weight: 700; }
  .brand-mark { flex: none; width: 1.75rem; height: 1.75rem; }
  .brand span { white-space: nowrap; }
  .brand-mark rect { fill: var(--accent); }
  .brand-mark path { fill: none; stroke: #fff; stroke-width: 1.8; stroke-linecap: round; }
  .brand-mark circle { fill: #fff; }

  .bar nav ul { display: flex; gap: 0.25rem; list-style: none; }
  .bar nav a {
    display: block;
    padding: 0.5rem 0.875rem;
    border-radius: var(--radius-sm);
    color: var(--frame-muted);
    text-decoration: none;
    font-size: var(--text-ui);
    font-weight: 500;
    transition: color 150ms ease, background-color 150ms ease;
  }
  .bar nav a:hover { color: var(--frame-text); background: var(--frame-raised); }
  .bar nav a[aria-current='page'] { color: var(--frame-text); background: var(--frame-raised); font-weight: 600; }

  .site-footer { margin-top: clamp(4.5rem, 10vw, 7.5rem); }
  .foot { padding-block: clamp(3rem, 6vw, 4rem) 2.5rem; font-size: var(--text-ui); color: var(--frame-muted); }
  .foot-top {
    display: grid;
    grid-template-columns: minmax(0, 1.5fr) minmax(0, 1fr) minmax(0, 1.2fr);
    gap: 2.5rem;
  }
  .foot-name { font-size: 1.25rem; font-weight: 700; color: var(--frame-text); letter-spacing: -0.03em; }
  .foot-slogan { margin-top: 0.5rem; line-height: 1.7; max-width: 22rem; }
  .foot-links { display: flex; flex-direction: column; gap: 0.625rem; align-items: flex-start; }
  .foot-links a { text-decoration: none; color: var(--frame-text); transition: color 150ms ease; }
  .foot-links a:hover { color: var(--accent-on-dark); }
  .foot-meta a { color: var(--frame-text); }
  .foot-meta a:hover { color: var(--accent-on-dark); }
  .foot-bottom {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: 0.75rem 2rem;
    align-items: start;
    margin-top: 2rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--frame-line);
  }
  .foot-copy { font-size: 0.8125rem; color: var(--frame-faint); white-space: nowrap; }
  .foot-license { display: flex; gap: 0.875rem; align-items: flex-start; }
  .cc-mark {
    display: inline-flex;
    flex: none;
    align-items: center;
    gap: 0.5rem;
    padding: 0.3rem 0.625rem 0.3rem 0.375rem;
    border: 1px solid var(--frame-line);
    border-radius: 999px;
    color: var(--frame-muted);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.02em;
    text-decoration: none;
    transition: color 150ms ease, border-color 150ms ease;
  }
  .cc-mark svg { width: 4.5rem; height: auto; display: block; }
  .cc-mark:hover { color: var(--accent-on-dark); border-color: var(--accent-on-dark); }
  .foot-license-text { font-size: 0.8125rem; line-height: 1.75; color: var(--frame-faint); max-width: 52rem; }
  .foot-license-text :global(a) { color: var(--frame-muted); text-decoration: underline; text-underline-offset: 2px; }
  .foot-license-text :global(a:hover) { color: var(--accent-on-dark); }

  @media (max-width: 720px) {
    .bar { min-height: 3.75rem; gap: 0.75rem; }
    /* 좁은 화면: 첫 줄에 로고 · 언어 탭, 둘째 줄에 메뉴 */
    .bar { flex-wrap: wrap; padding-block: 0.625rem 0.375rem; row-gap: 0.25rem; }
    .bar-lang { padding-left: 0; border-left: 0; }
    .bar nav { order: 3; flex-basis: 100%; margin-left: -0.625rem; }
    .brand span { font-size: 0.9875rem; }
    .bar nav a { padding: 0.4375rem 0.625rem; font-size: 0.9rem; }
    .foot-top { grid-template-columns: 1fr; gap: 1.75rem; }
    .foot-bottom { grid-template-columns: 1fr; }
    .foot-license { flex-direction: column; gap: 0.625rem; }
  }
  @media (max-width: 480px) {
    .bar { gap: 0.5rem; }
    .brand { gap: 0.5rem; }
    .brand span { font-size: 0.9375rem; }
    .bar nav ul { gap: 0; }
    .bar nav a { padding: 0.4375rem 0.5rem; font-size: 0.875rem; }
    .bar nav { margin-left: -0.5rem; }
  }
  /* 아주 좁은 화면에서는 첫 줄(이름 · 언어 탭)이 넘치지 않도록 로고 표시를 뺀다 */
  @media (max-width: 359px) {
    .brand-mark { display: none; }
  }
</style>
