---
import 'pretendard/dist/web/variable/pretendardvariable-dynamic-subset.css';
import '../styles/global.css';
import Icon from '../components/Icon.astro';
import { SITE } from '../data/site';
import { t, blogPath, articlesPath, pagePath, OG_LOCALE, HREFLANG, DEFAULT_LANG, type Lang, type Alternate } from '../i18n/ui';

interface Props {
  title?: string;
  description?: string;
  type?: 'website' | 'article';
  jsonLd?: Record<string, unknown>;
  image?: string;
  lang?: Lang;
  // 같은 내용의 다른 언어 페이지들 (자기 자신 포함). 두 개 이상일 때 hreflang 태그를 넣는다
  alternates?: Alternate[];
}

const { title, type = 'website', jsonLd, image, lang = DEFAULT_LANG, alternates = [] } = Astro.props;
const tr = t(lang);
const description = Astro.props.description ?? tr.description;
const slogan = tr.slogan;
const fullTitle = title ? `${title} | ${SITE.name}` : `${SITE.name} — ${slogan}`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const path = Astro.url.pathname;
const articlesHref = articlesPath(lang);
const isCurrent = (href: string) =>
  href === '/' ? path === '/' || path.startsWith('/articles')
  : href === articlesHref ? path.startsWith(articlesHref)
  : path.startsWith(href);
// 메뉴 · 푸터 링크는 지금 보고 있는 언어의 페이지로 간다
const nav = [
  { href: articlesHref, label: tr.nav.articles },
  { href: blogPath(lang), label: tr.nav.blog },
  { href: pagePath(lang, '/about/'), label: tr.nav.about },
  { href: pagePath(lang, '/contact/'), label: tr.nav.contact },
];
const privacyHref = pagePath(lang, '/privacy/');
const abs = (href: string) => new URL(href, Astro.site).toString();
---
<!doctype html>
<html lang={HREFLANG[lang]}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="google-site-verification" content="zxZW0YclDH3R_GsIjoLKVRfqxiPKT_ZzV8YWoU35YPc" />
    <link rel="canonical" href={canonical} />
    {alternates.length > 1 && (
      <>
        {alternates.map((a) => <link rel="alternate" hreflang={HREFLANG[a.lang]} href={abs(a.href)} />)}
        <link rel="alternate" hreflang="x-default" href={abs((alternates.find((a) => a.lang === DEFAULT_LANG) ?? alternates[0]).href)} />
      </>
    )}
    <link rel="alternate" type="application/rss+xml" title={SITE.name} href={new URL("rss.xml", Astro.site)} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="theme-color" content="#0f141c" />
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={title ?? SITE.name} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={OG_LOCALE[lang]} />
    {alternates.filter((a) => a.lang !== lang).map((a) => <meta property="og:locale:alternate" content={OG_LOCALE[a.lang]} />)}
    {image && <meta property="og:image" content={new URL(image, Astro.site)} />}
    <meta name="twitter:card" content={image ? "summary_large_image" : "summary"} />
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
    {/* 구글 애널리틱스 · 애드센스: ID가 있을 때, 배포용 빌드에서만 불러온다 */}
    {import.meta.env.PROD && SITE.gaId && (
      <>
        <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${SITE.gaId}`}></script>
        <script is:inline define:vars={{ gaId: SITE.gaId }}>
          window.dataLayer = window.dataLayer || [];
          window.gtag = function () { dataLayer.push(arguments); };
          gtag('js', new Date());
          gtag('config', gaId);
        </script>
      </>
    )}
    {import.meta.env.PROD && SITE.adsenseClient && (
      <script is:inline async src={`https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${SITE.adsenseClient}`} crossorigin="anonymous"></script>
    )}
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#main">{tr.skip}</a>
    <header class="site-header frame">
      <div class="wrap bar">
        <a class="brand" href={articlesHref} aria-label={`${SITE.name} ${tr.home}`}>
          <svg class="brand-mark" viewBox="0 0 28 28" aria-hidden="true">
            <rect width="28" height="28" rx="8" />
            <path d="M8 18.5c2.5-9 9.5 0 12-9" />
            <circle cx="8" cy="18.5" r="2.25" />
            <circle cx="20" cy="9.5" r="2.25" />
          </svg>
          <span>믿음의 게임, <b>실행</b></span>
        </a>
        <nav aria-label={tr.mainMenu}>
          <ul>
            {nav.map((item) => (
              <li><a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>{item.label}</a></li>
            ))}
          </ul>
        </nav>
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="site-footer frame">
      <div class="wrap foot">
        <div class="foot-top">
          <div class="foot-brand">
            <p class="foot-name">믿음의 게임, 실행</p>
            <p class="foot-slogan">{slogan}</p>
          </div>
          <nav class="foot-links" aria-label={tr.foot.label}>
            <a href={pagePath(lang, '/about/')}>{tr.nav.about}</a>
            <a href={pagePath(lang, '/contact/')}>{tr.nav.contact}</a>
            <a href={privacyHref}>{tr.foot.privacy}</a>
            <a href={privacyHref + '#disclaimer'}>{tr.foot.disclaimer}</a>
          </nav>
          <div class="foot-meta">
            <p>{tr.foot.email} <a href={`mailto:${SITE.email}`}>{SITE.email}</a></p>
          </div>
        </div>
        <section class="foot-disclaimer" aria-labelledby="foot-disclaimer-title">
          <h2 id="foot-disclaimer-title"><Icon name="info" /> {tr.foot.title}</h2>
          <p set:html={tr.foot.body} />
          <a class="foot-disclaimer-link" href={privacyHref + '#disclaimer'}>{tr.foot.more} <Icon name="arrow-right" /></a>
        </section>
        <p class="foot-copy tabular">© {new Date().getFullYear()} 믿음의 게임, 실행</p>
      </div>
    </footer>

    <div class="toast" data-toast role="status" aria-live="polite"><Icon name="check" /><span data-toast-text></span></div>

    <script>
      // 어디서든 document.dispatchEvent(new CustomEvent('toast', { detail: '문구' }))로 띄운다.
      const toast = document.querySelector<HTMLElement>('[data-toast]');
      const text = toast?.querySelector<HTMLElement>('[data-toast-text]');
      let timer = 0;
      document.addEventListener('toast', (e) => {
        if (!toast || !text) return;
        text.textContent = String((e as CustomEvent).detail ?? '');
        toast.classList.add('is-on');
        clearTimeout(timer);
        timer = window.setTimeout(() => toast.classList.remove('is-on'), 2200);
      });
    </script>
  </body>
</html>

<style>
  .site-header { position: relative; z-index: 5; border-bottom: 1px solid var(--frame-line); }
  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    min-height: 4.25rem;
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.625rem;
    text-decoration: none;
    font-weight: 700;
    font-size: 1.0625rem;
    letter-spacing: -0.03em;
    border-radius: var(--radius-sm);
  }
  .brand b { color: var(--accent-on-dark); font-weight: 700; }
  .brand-mark { flex: none; width: 1.75rem; height: 1.75rem; }
  .brand span { white-space: nowrap; }
  .brand-mark rect { fill: var(--accent); }
  .brand-mark path { fill: none; stroke: #fff; stroke-width: 1.8; stroke-linecap: round; }
  .brand-mark circle { fill: #fff; }

  .bar nav ul { display: flex; gap: 0.25rem; list-style: none; }
  .bar nav a {
    display: block;
    padding: 0.5rem 0.875rem;
    border-radius: var(--radius-sm);
    color: var(--frame-muted);
    text-decoration: none;
    font-size: var(--text-ui);
    font-weight: 500;
    transition: color 150ms ease, background-color 150ms ease;
  }
  .bar nav a:hover { color: var(--frame-text); background: var(--frame-raised); }
  .bar nav a[aria-current='page'] { color: var(--frame-text); background: var(--frame-raised); font-weight: 600; }

  .site-footer { margin-top: clamp(4.5rem, 10vw, 7.5rem); }
  .foot { padding-block: clamp(3rem, 6vw, 4rem) 2.5rem; font-size: var(--text-ui); color: var(--frame-muted); }
  .foot-top {
    display: grid;
    grid-template-columns: minmax(0, 1.5fr) minmax(0, 1fr) minmax(0, 1.2fr);
    gap: 2.5rem;
  }
  .foot-name { font-size: 1.25rem; font-weight: 700; color: var(--frame-text); letter-spacing: -0.03em; }
  .foot-slogan { margin-top: 0.5rem; line-height: 1.7; max-width: 22rem; }
  .foot-links { display: flex; flex-direction: column; gap: 0.625rem; align-items: flex-start; }
  .foot-links a { text-decoration: none; color: var(--frame-text); transition: color 150ms ease; }
  .foot-links a:hover { color: var(--accent-on-dark); }
  .foot-meta a { color: var(--frame-text); }
  .foot-meta a:hover { color: var(--accent-on-dark); }
  .foot-disclaimer {
    margin-top: 2.5rem;
    padding: 1.375rem 1.5rem;
    border: 1px solid var(--frame-line);
    border-radius: var(--radius-card);
    background: var(--frame-raised);
  }
  .foot-disclaimer h2 { display: flex; align-items: center; gap: 0.5rem; font-size: var(--text-ui); font-weight: 700; color: var(--frame-text); }
  .foot-disclaimer h2 :global(.icon) { color: var(--accent-on-dark); }
  .foot-disclaimer p { margin-top: 0.625rem; font-size: 0.875rem; line-height: 1.8; color: var(--frame-muted); max-width: 62rem; }
  .foot-disclaimer strong { color: var(--frame-text); font-weight: 600; }
  .foot-disclaimer-link {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    margin-top: 0.75rem;
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--accent-on-dark);
    text-decoration: none;
  }
  .foot-disclaimer-link :global(.icon) { transition: transform 200ms var(--ease-out); }
  .foot-disclaimer-link:hover { text-decoration: underline; }
  .foot-copy { margin-top: 2rem; padding-top: 1.5rem; border-top: 1px solid var(--frame-line); font-size: 0.8125rem; color: var(--frame-faint); }

  @media (hover: hover) and (pointer: fine) and (prefers-reduced-motion: no-preference) {
    .foot-disclaimer-link:hover :global(.icon) { transform: translateX(3px); }
  }
  @media (max-width: 720px) {
    .bar { min-height: 3.75rem; gap: 0.75rem; }
    .brand span { font-size: 0.9875rem; }
    .bar nav a { padding: 0.4375rem 0.625rem; font-size: 0.9rem; }
    .foot-top { grid-template-columns: 1fr; gap: 1.75rem; }
  }
  @media (max-width: 480px) {
    .bar { gap: 0.5rem; }
    .brand { gap: 0.5rem; }
    .brand span { font-size: 0.9375rem; }
    .bar nav ul { gap: 0; }
    .bar nav a { padding: 0.4375rem 0.5rem; font-size: 0.875rem; }
  }
  @media (max-width: 380px) {
    .brand-mark { display: none; }
  }
  /* 영어 · 일본어 메뉴는 한국어보다 길어서, 아주 좁은 화면에서는 이름 대신 로고 표시만 남긴다 */
  @media (max-width: 400px) {
    :global(html:not([lang='ko'])) .brand span { display: none; }
    :global(html:not([lang='ko'])) .brand-mark { display: block; }
  }
</style>
