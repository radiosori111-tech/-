---
import '@fontsource-variable/hahmlet';
import 'pretendard/dist/web/variable/pretendardvariable-dynamic-subset.css';
import '../styles/global.css';
import { SITE, NAV } from '../data/site';

interface Props {
  title?: string;
  description?: string;
  type?: 'website' | 'article';
  jsonLd?: Record<string, unknown>;
}

const { title, description = SITE.description, type = 'website', jsonLd } = Astro.props;
const fullTitle = title ? `${title} | ${SITE.name}` : `${SITE.name} — ${SITE.slogan}`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const path = Astro.url.pathname;
const isCurrent = (href: string) =>
  href === '/' ? path === '/' || path.startsWith('/articles') : path.startsWith(href);
---
<!doctype html>
<html lang="ko">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="theme-color" content="#0f1622" />
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={title ?? SITE.name} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={SITE.locale} />
    <meta name="twitter:card" content="summary" />
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#main">본문으로 건너뛰기</a>
    <header class="site-header night">
      <div class="wrap bar">
        <a class="brand" href="/" aria-label={`${SITE.name} 홈`}>
          <svg class="brand-mark" viewBox="0 0 32 32" aria-hidden="true">
            <path d="M3 21h26" />
            <circle cx="12" cy="15.5" r="4.5" />
          </svg>
          <span>믿음의 게임, <b>실행</b></span>
        </a>
        <nav aria-label="주 메뉴">
          <ul>
            {NAV.map((item) => (
              <li><a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>{item.label}</a></li>
            ))}
          </ul>
        </nav>
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="site-footer night">
      <div class="wrap foot">
        <div class="foot-brand">
          <p class="foot-name">믿음의 게임, 실행</p>
          <p class="foot-slogan">{SITE.slogan}</p>
        </div>
        <nav class="foot-links" aria-label="사이트 정보">
          <a href="/about/">소개</a>
          <a href="/contact/">문의</a>
          <a href="/privacy/">개인정보 처리방침</a>
          <a href="/privacy/#disclaimer">면책조항 (Disclaimer)</a>
        </nav>
        <div class="foot-meta">
          <p>문의 <a href={`mailto:${SITE.email}`}>{SITE.email}</a></p>
        </div>
        <section class="foot-disclaimer" aria-labelledby="foot-disclaimer-title">
          <h2 id="foot-disclaimer-title">의학 · 학술 정보 면책 조항</h2>
          <p>{SITE.name}의 모든 콘텐츠는 공개된 연구와 학회 권고를 바탕으로 한 <strong>일반적인 정보 제공</strong>을 목적으로 하며, 의사 등 전문가의 <strong>진단, 치료, 처방을 대신하지 않습니다.</strong> 연구 결과는 개인에 따라 다르게 나타날 수 있으므로 건강에 관한 결정은 반드시 전문가와 상담하세요. 이 사이트의 정보를 이용해 생긴 결과에 대해 사이트는 법적 책임을 지지 않습니다. 응급 상황에서는 즉시 119에 연락하세요.</p>
          <a class="foot-disclaimer-link" href="/privacy/#disclaimer">면책조항 전문 보기</a>
        </section>
        <p class="foot-copy tabular">© {new Date().getFullYear()} 믿음의 게임, 실행</p>
      </div>
    </footer>
  </body>
</html>

<style>
  .site-header { position: relative; z-index: 5; border-bottom: 1px solid var(--night-line); }
  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    min-height: 4.5rem;
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.625rem;
    text-decoration: none;
    font-weight: 600;
    font-size: 1.0625rem;
    letter-spacing: -0.02em;
  }
  .brand b { color: var(--sun); font-weight: 700; }
  .brand-mark { width: 1.75rem; height: 1.75rem; fill: none; stroke-width: 1.6; }
  .brand-mark path { stroke: var(--night-muted); }
  .brand-mark circle { stroke: var(--sun); fill: var(--sun); fill-opacity: 0.18; }

  .bar nav ul { display: flex; gap: 0.25rem; list-style: none; }
  .bar nav a {
    display: block;
    padding: 0.5rem 0.875rem;
    border-radius: 3px;
    color: var(--night-muted);
    text-decoration: none;
    font-size: 0.9375rem;
    font-weight: 500;
    transition: color 0.2s, background-color 0.2s;
  }
  .bar nav a:hover { color: var(--night-text); background: var(--night-raised); }
  .bar nav a[aria-current='page'] { color: var(--night-text); }
  .bar nav a[aria-current='page']::after {
    content: '';
    display: block;
    width: 5px; height: 5px;
    margin: 0.25rem auto -0.5625rem;
    border-radius: 50%;
    background: var(--sun);
  }

  .site-footer { margin-top: clamp(4rem, 10vw, 8rem); }
  .foot {
    display: grid;
    grid-template-columns: 1.4fr 1fr 1.4fr;
    gap: 2.5rem;
    padding-block: 3.5rem 3rem;
    font-size: 0.9375rem;
    color: var(--night-muted);
  }
  .foot-name { font-family: var(--font-read); font-size: 1.375rem; font-weight: 600; color: var(--night-text); letter-spacing: -0.02em; }
  .foot-slogan { margin-top: 0.5rem; line-height: 1.7; max-width: 22rem; }
  .foot-links { display: flex; flex-direction: column; gap: 0.625rem; align-items: flex-start; }
  .foot-links a { text-decoration: none; color: var(--night-text); }
  .foot-links a:hover { color: var(--sun); }
  .foot-meta { display: grid; gap: 0.75rem; align-content: start; }
  .foot-meta a { color: var(--night-text); }
  .foot-disclaimer {
    grid-column: 1 / -1;
    padding: 1.25rem 1.5rem;
    border: 1px solid var(--night-line);
    border-radius: 4px;
    background: var(--night-raised);
  }
  .foot-disclaimer h2 { font-size: 0.9375rem; font-weight: 700; color: var(--night-text); }
  .foot-disclaimer p { margin-top: 0.5rem; font-size: 0.875rem; line-height: 1.75; color: var(--night-muted); max-width: 62rem; }
  .foot-disclaimer-link { display: inline-block; margin-top: 0.75rem; font-size: 0.875rem; font-weight: 600; color: var(--sun); text-underline-offset: 0.22em; }
  .foot-disclaimer-link:hover { color: var(--night-text); }
  .foot-disclaimer strong { color: var(--night-text); font-weight: 600; }
  .foot-copy { grid-column: 1 / -1; font-size: 0.8125rem; color: var(--night-faint); }

  @media (max-width: 720px) {
    .bar { min-height: 3.75rem; }
    .brand span { font-size: 0.9875rem; }
    .bar nav a { padding: 0.5rem 0.625rem; font-size: 0.9rem; }
    .foot { grid-template-columns: 1fr; gap: 2rem; }
  }
  @media (max-width: 380px) {
    .brand-mark { display: none; }
  }
</style>
