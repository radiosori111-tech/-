---
// 아티클(/articles/…)과 블로그(/blog/…) 글 페이지가 함께 쓰는 상세 레이아웃.
// 머리말 · 진행 막대 · 목차 · 본문 · 광고 · 면책 · 반응/공유 · 이전/다음 글을 한 구조로 그린다.
import type { MarkdownHeading } from 'astro';
import Base from './Base.astro';
import Icon from '../components/Icon.astro';
import HeroBrain from '../components/HeroBrain.astro';
import Disclaimer from '../components/Disclaimer.astro';
import AdSlot from '../components/ads/AdSlot.astro';
import Comic from '../components/comic/Comic.astro';
import type { Scene } from '../components/comic/scenes';
import LangSwitch from '../components/LangSwitch.astro';
import { t, DEFAULT_LANG, type Lang, type Alternate } from '../i18n/ui';

interface PagerLink {
  href: string;
  title: string;
  // 아티클은 글이 놓인 시각을 함께 보여 준다
  badge?: { text: string; anytime?: boolean };
}

interface Props {
  title: string;
  description: string;
  jsonLd: Record<string, unknown>;
  image?: string;
  url: string;
  back: { href: string; label: string };
  headings: MarkdownHeading[];
  // 읽은 정도 · 반응을 이 브라우저에 저장할 때 쓰는 이름
  storageKey: string;
  reviewed: Date;
  tags?: string[];
  prev?: PagerLink | null;
  next?: PagerLink | null;
  prevLabel: string;
  nextLabel: string;
  related?: { title: string; items: { href: string; title: string; note: string }[] };
  lang?: Lang;
  alternates?: Alternate[];
  comic?: { title?: string; panels: { scene?: Scene; image?: string; alt: string; label: string; caption: string; bubble?: string }[] };
}

const {
  title, description, jsonLd, image, url, back, headings, storageKey, reviewed,
  tags = [], prev, next, prevLabel, nextLabel, related, lang = DEFAULT_LANG, alternates = [], comic,
} = Astro.props;
const tr = t(lang).post;
const pageUrl = new URL(url, Astro.site).toString();

// 소제목이 두 개 이상인 단계로 목차를 만든다 (h2가 없는 글은 h3로)
const level = [2, 3].find((d) => headings.filter((h) => h.depth === d).length >= 2);
const toc = level ? headings.filter((h) => h.depth === level) : [];
---
<Base title={title} description={description} type="article" jsonLd={jsonLd} image={image} lang={lang} alternates={alternates}>
  <div class:list={['post-page', toc.length === 0 && 'is-narrow']}>
    <header class="art-head frame">
      <HeroBrain lang={lang} />
      <div class="wrap head-inner">
        <div class="head-top">
          <a class="back" href={back.href}><Icon name="arrow-left" /> {back.label}</a>
          <LangSwitch alternates={alternates} current={lang} label={tr.readIn} compact />
        </div>
        <h1>{title}</h1>
        <p class="lede">{description}</p>
        <dl class="meta">
          <slot name="meta" />
        </dl>
      </div>
    </header>

    <div class="progress" data-progress aria-hidden="true">
      <div class="wrap progress-inner">
        <span class="progress-title">{title}</span>
        <span class="progress-pct tabular" data-pct>0%</span>
      </div>
      <div class="progress-line"><span data-fill></span><span class="progress-flag" data-flag hidden></span></div>
    </div>

    <div class="art-surface">
      <div class="wrap art-grid">
        {toc.length > 0 && (
          <aside class="toc" aria-labelledby="toc-title">
            <details class="toc-box" open data-toc>
              <summary id="toc-title"><Icon name="list" /> {tr.toc}<span class="toc-chevron"><Icon name="chevron-down" /></span></summary>
              <ol>
                {toc.map((h) => <li><a href={`#${h.slug}`} data-toc-link={h.slug}>{h.text}</a></li>)}
              </ol>
            </details>
          </aside>
        )}

        <article class="prose" data-article data-key={storageKey}>
          <div class="resume" data-resume hidden>
            <Icon name="flag" />
            <p set:html={tr.resume('<span data-resume-pct></span>')} />
            <button type="button" class="btn btn-secondary btn-sm" data-resume-go>{tr.resumeGo}</button>
          </div>

          {comic && <Comic comic={comic} lang={lang} />}
          <AdSlot position="top" lang={lang} />
          <slot />
          <AdSlot position="bottom" lang={lang} />

          {tags.length > 0 && (
            <ul class="tags" aria-label={tr.tags}>
              {tags.map((t) => <li class="chip">#{t}</li>)}
            </ul>
          )}

          <Disclaimer reviewed={reviewed} lang={lang} />

          <section class="respond" aria-labelledby="respond-title">
            <h2 id="respond-title" class="respond-title">{tr.respond}</h2>
            <div class="react" role="group" aria-label={tr.reactGroup}>
              <button type="button" class="react-btn" aria-pressed="false" data-react="helpful"><Icon name="heart" /> {tr.helpful}</button>
              <button type="button" class="react-btn" aria-pressed="false" data-react="try"><Icon name="spark" /> {tr.tryIt}</button>
            </div>
            <p class="react-note">{tr.reactNote}</p>

            <div class="share" role="group" aria-label={tr.shareGroup} data-copied={tr.copied} data-copied-toast={tr.copiedToast} data-copy-fail={tr.copyFail} data-copy-text={tr.copy}>
              <span class="share-label">{tr.share}</span>
              <button type="button" class="share-btn" data-copy><Icon name="link" /> <span data-copy-label>{tr.copy}</span></button>
              <a class="share-btn" href={`https://twitter.com/intent/tweet?text=${encodeURIComponent(title)}&url=${encodeURIComponent(pageUrl)}`} target="_blank" rel="noopener"><Icon name="x" /> X</a>
              <a class="share-btn" href={`https://www.facebook.com/sharer/sharer.php?u=${encodeURIComponent(pageUrl)}`} target="_blank" rel="noopener"><Icon name="facebook" /> {tr.facebook}</a>
              <button type="button" class="share-btn" data-native-share hidden><Icon name="share" /> {tr.nativeShare}</button>
            </div>
          </section>
        </article>
      </div>

      <nav class="wrap pager" aria-label={tr.otherPosts}>
        {prev ? (
          <a class="pager-link" href={prev.href}>
            <span class="pager-dir"><Icon name="arrow-left" /> {prevLabel} {prev.badge && <span class:list={['time-mark', prev.badge.anytime && 'anytime']}>{prev.badge.text}</span>}</span>
            <span class="pager-title">{prev.title}</span>
          </a>
        ) : <span />}
        {next ? (
          <a class="pager-link to-next" href={next.href}>
            <span class="pager-dir">{nextLabel} {next.badge && <span class:list={['time-mark', next.badge.anytime && 'anytime']}>{next.badge.text}</span>} <Icon name="arrow-right" /></span>
            <span class="pager-title">{next.title}</span>
          </a>
        ) : <span />}
      </nav>

      {related && related.items.length > 0 && (
        <section class="wrap related" aria-labelledby="related-title">
          <h2 id="related-title">{related.title}</h2>
          <ul>
            {related.items.map((r) => (
              <li><a href={r.href}>{r.title}</a><span class="tabular">{r.note}</span></li>
            ))}
          </ul>
        </section>
      )}
    </div>
  </div>
</Base>

<script>
  const article = document.querySelector<HTMLElement>('[data-article]')!;
  const key = article.dataset.key!;
  const bar = document.querySelector<HTMLElement>('[data-progress]')!;
  const fill = bar.querySelector<HTMLElement>('[data-fill]')!;
  const flag = bar.querySelector<HTMLElement>('[data-flag]')!;
  const pctLabel = bar.querySelector<HTMLElement>('[data-pct]')!;

  const read = (k: string) => { try { return JSON.parse(localStorage.getItem(k) || '{}'); } catch { return {}; } };
  const write = (k: string, v: unknown) => { try { localStorage.setItem(k, JSON.stringify(v)); } catch {} };

  // 지난번 멈춘 자리: 깃발과 이어 읽기
  const last = read('mgs:last')[key] as number | undefined;
  if (last && last > 0.05 && last < 0.9) {
    flag.style.left = `${last * 100}%`;
    flag.hidden = false;
    const resume = document.querySelector<HTMLElement>('[data-resume]')!;
    resume.querySelector('[data-resume-pct]')!.textContent = `${Math.round(last * 100)}%`;
    resume.hidden = false;
    resume.querySelector('[data-resume-go]')!.addEventListener('click', () => {
      const top = article.offsetTop + article.offsetHeight * last - innerHeight * 0.3;
      scrollTo({ top, behavior: 'smooth' });
      resume.hidden = true;
    });
  }

  function fraction() {
    const start = article.offsetTop - innerHeight * 0.3;
    const end = article.offsetTop + article.offsetHeight - innerHeight;
    return Math.min(1, Math.max(0, (scrollY - start) / Math.max(1, end - start)));
  }

  let ticking = false;
  let saveTimer = 0;
  function update() {
    ticking = false;
    const f = fraction();
    fill.style.transform = `scaleX(${f})`;
    pctLabel.textContent = `${Math.round(f * 100)}%`;
    bar.classList.toggle('is-shown', scrollY > article.offsetTop - 80);
    clearTimeout(saveTimer);
    saveTimer = window.setTimeout(() => {
      const max = read('mgs:progress');
      max[key] = Math.max(max[key] ?? 0, f);
      write('mgs:progress', max);
      const lastAll = read('mgs:last');
      lastAll[key] = f;
      write('mgs:last', lastAll);
    }, 400);
  }
  addEventListener('scroll', () => { if (!ticking) { ticking = true; requestAnimationFrame(update); } }, { passive: true });
  update();

  // 목차: 지금 읽는 절을 표시
  const links = [...document.querySelectorAll<HTMLAnchorElement>('[data-toc-link]')];
  const sections = links.map((l) => document.getElementById(l.dataset.tocLink!)).filter(Boolean) as HTMLElement[];
  if (sections.length) {
    const io = new IntersectionObserver(() => {
      let current = sections[0];
      for (const s of sections) if (s.getBoundingClientRect().top < innerHeight * 0.35) current = s;
      links.forEach((l) => l.toggleAttribute('aria-current', l.dataset.tocLink === current?.id));
    }, { rootMargin: '0px 0px -60% 0px', threshold: [0, 1] });
    sections.forEach((s) => io.observe(s));
  }
  const toc = document.querySelector<HTMLDetailsElement>('[data-toc]');
  if (toc && matchMedia('(max-width: 1100px)').matches) toc.open = false;

  // 반응: 이 브라우저에만 저장
  const reactions = read('mgs:react');
  document.querySelectorAll<HTMLButtonElement>('[data-react]').forEach((btn) => {
    const rkey = `${key}:${btn.dataset.react}`;
    btn.setAttribute('aria-pressed', String(!!reactions[rkey]));
    btn.addEventListener('click', () => {
      const on = btn.getAttribute('aria-pressed') !== 'true';
      btn.setAttribute('aria-pressed', String(on));
      if (on && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
        btn.querySelector('.icon')?.animate(
          [{ transform: 'scale(1)' }, { transform: 'scale(1.25)' }, { transform: 'scale(1)' }],
          { duration: 320, easing: 'cubic-bezier(0.23, 1, 0.32, 1)' },
        );
      }
      const r = read('mgs:react');
      if (on) r[rkey] = 1; else delete r[rkey];
      write('mgs:react', r);
    });
  });

  // 공유
  document.querySelector<HTMLButtonElement>('[data-copy]')?.addEventListener('click', async (e) => {
    const label = (e.currentTarget as HTMLElement).querySelector('[data-copy-label]')!;
    const text = document.querySelector<HTMLElement>('.share')!.dataset;
    try {
      await navigator.clipboard.writeText(location.href.split('#')[0]);
      label.textContent = text.copied!;
      document.dispatchEvent(new CustomEvent('toast', { detail: text.copiedToast }));
    } catch {
      label.textContent = text.copyFail!;
    }
    setTimeout(() => (label.textContent = text.copyText!), 2200);
  });
  const native = document.querySelector<HTMLButtonElement>('[data-native-share]');
  if (native && 'share' in navigator) {
    native.hidden = false;
    native.addEventListener('click', () => navigator.share({ title: document.title, url: location.href.split('#')[0] }).catch(() => {}));
  }
</script>

<style>
  .post-page { --head-max: calc(var(--measure) + 16rem + clamp(2.5rem, 5vw, 4.5rem) + var(--gutter) * 2); }
  /* 목차가 없는 글은 머리말 · 본문 · 이전/다음 글을 본문 폭 하나로 맞춘다 */
  .post-page.is-narrow { --head-max: calc(var(--measure) + var(--gutter) * 2); }

  .art-head { padding-block: clamp(2rem, 5vw, 3rem) clamp(3rem, 7vw, 4.75rem); }
  .head-inner { max-width: var(--head-max); }
  .head-inner > * { max-width: 50rem; }
  /* 돌아가기 링크와 언어 탭을 한 줄에. 좁은 화면에서 모자라면 탭이 다음 줄로 내려간다 */
  .head-top {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem 1rem;
  }
  .back {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    padding: 0.375rem 0.75rem 0.375rem 0.5rem;
    margin-left: -0.5rem;
    border-radius: var(--radius-sm);
    font-size: var(--text-ui);
    color: var(--frame-muted);
    text-decoration: none;
    transition: color 150ms ease, background-color 150ms ease;
  }
  .back :global(.icon) { transition: transform 220ms var(--ease-out); }
  .back:hover { color: var(--frame-text); background: var(--frame-raised); }
  .art-head h1 {
    margin-top: clamp(1.5rem, 4vw, 2.25rem);
    font-size: clamp(1.875rem, 1.3rem + 2.4vw, 3rem);
    font-weight: 700;
    line-height: 1.28;
    letter-spacing: -0.04em;
    text-wrap: balance;
  }
  .lede {
    margin-top: 1.25rem;
    font-size: var(--text-lg);
    line-height: 1.8;
    color: var(--frame-muted);
    max-width: 44rem;
  }
  .meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 1.5rem;
    margin: 2rem 0 0;
    font-size: var(--text-ui);
    color: var(--frame-muted);
  }
  .meta :global(div) { display: flex; gap: 0.375rem; }
  .meta :global(dt:not(.visually-hidden)) { color: var(--frame-faint); }
  .meta :global(dd) { margin: 0; }

  .art-surface { padding-bottom: clamp(3rem, 6vw, 4.5rem); }

  .progress {
    position: sticky;
    top: 0;
    z-index: 10;
    background: var(--surface);
    border-bottom: 1px solid var(--line);
    box-shadow: var(--shadow-sm);
    transform: translateY(-100%);
    opacity: 0;
    transition: transform 280ms var(--ease-out), opacity 200ms ease;
    margin-bottom: -3.25rem;
  }
  .progress.is-shown { transform: none; opacity: 1; }
  .progress-inner {
    max-width: var(--head-max);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    height: 3.125rem;
    font-size: var(--text-sm);
  }
  .progress-title { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-weight: 600; color: var(--ink); letter-spacing: -0.02em; }
  .progress-pct { flex: none; padding: 0.125rem 0.5rem; border-radius: 999px; background: var(--accent-soft); color: var(--accent-strong); font-size: var(--text-xs); font-weight: 700; }
  .progress-line { position: relative; height: 3px; background: var(--sunk); }
  .progress-line [data-fill] {
    position: absolute;
    inset: 0;
    background: var(--accent);
    transform-origin: left center;
    transform: scaleX(0);
  }
  .progress-flag {
    position: absolute;
    top: -7px;
    width: 2px; height: 17px;
    background: var(--ink);
  }
  .progress-flag::after {
    content: '';
    position: absolute;
    left: 2px; top: 0;
    width: 8px; height: 8px;
    background: var(--ink);
    clip-path: polygon(0 0, 100% 50%, 0 100%);
  }

  .art-grid {
    display: grid;
    grid-template-columns: minmax(0, var(--measure)) minmax(0, 16rem);
    justify-content: center;
    gap: clamp(2.5rem, 5vw, 4.5rem);
    padding-top: clamp(2.75rem, 6vw, 4.5rem);
  }
  .is-narrow .art-grid { grid-template-columns: minmax(0, var(--measure)); }
  .toc { order: 2; }
  .toc-box {
    position: sticky;
    top: 5rem;
    padding: 1.125rem 0.75rem 0.75rem;
    border: 1px solid var(--line);
    border-radius: var(--radius-card);
    background: var(--surface);
    box-shadow: var(--shadow-sm);
  }
  .toc summary {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0 0.5rem 0.75rem;
    list-style: none;
    font-size: var(--text-sm);
    font-weight: 700;
    color: var(--ink);
    cursor: pointer;
  }
  .toc summary :global(.icon) { color: var(--accent); }
  .toc-chevron { margin-left: auto; display: grid; place-items: center; transition: transform 200ms var(--ease-out); }
  .toc summary .toc-chevron :global(.icon) { color: var(--muted); }
  .toc-box[open] .toc-chevron { transform: rotate(180deg); }
  .toc summary::-webkit-details-marker { display: none; }
  .toc ol { list-style: none; display: grid; gap: 0.125rem; max-height: calc(100vh - 10rem); overflow-y: auto; }
  .toc a {
    display: block;
    padding: 0.4375rem 0.625rem;
    border-radius: var(--radius-sm);
    font-size: var(--text-sm);
    line-height: 1.55;
    color: var(--muted);
    text-decoration: none;
    transition: color 150ms ease, background-color 150ms ease;
  }
  .toc a:hover { color: var(--ink); background: var(--sunk); }
  .toc a[aria-current] { color: var(--accent-strong); background: var(--accent-soft); font-weight: 600; }

  .prose { order: 1; font-size: var(--text-lg); line-height: 1.85; letter-spacing: -0.008em; color: var(--ink-soft); overflow-wrap: break-word; }
  .resume {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.625rem 0.875rem;
    margin-bottom: 2.5rem;
    padding: 0.875rem 0.875rem 0.875rem 1.125rem;
    border: 1px solid var(--accent-line);
    border-radius: var(--radius-card);
    background: var(--accent-soft);
    font-size: var(--text-ui);
    line-height: 1.5;
    color: var(--ink);
    transition: opacity 240ms ease, transform 280ms var(--ease-out);
  }
  @starting-style { .resume { opacity: 0; transform: translateY(-6px); } }
  .resume > :global(.icon) { color: var(--accent); }
  .resume p { margin: 0 !important; flex: 1 1 14rem; }
  .resume button { margin-left: auto; }

  /* 본문 */
  .prose :global(p) { margin-block: 0 1.4em; }
  .prose :global(:is(h2, h3, h4)) { color: var(--ink); font-weight: 700; scroll-margin-top: 5rem; }
  .prose :global(h2) { margin: 2.6em 0 0.8em; font-size: var(--text-2xl); line-height: 1.4; letter-spacing: -0.03em; }
  .prose :global(h3) { margin: 2em 0 0.7em; font-size: var(--text-xl); line-height: 1.45; letter-spacing: -0.025em; }
  .prose :global(h4) { margin: 1.75em 0 0.6em; font-size: var(--text-md); line-height: 1.5; letter-spacing: -0.02em; }
  /* 본문 첫 요소(인용 · 소제목 등)는 위 여백 없이 시작한다 */
  .prose :global(:is(.resume, .ad) + *) { margin-top: 0; }
  .prose :global(strong) { font-weight: 650; color: var(--ink); }
  .prose :global(ul), .prose :global(ol) { margin: 0 0 1.4em; padding-left: 1.4em; }
  .prose :global(li) { margin-bottom: 0.6em; padding-left: 0.25em; }
  .prose :global(li::marker) { color: var(--accent); font-weight: 600; }
  .prose :global(em) { font-style: italic; }
  .prose :global(a) { color: var(--accent-strong); font-weight: 500; }
  .prose :global(a:hover) { color: var(--accent); }
  .prose :global(img) {
    display: block;
    max-width: 100%;
    height: auto;
    margin: 0 auto;
    border-radius: var(--radius-card);
    background: var(--sunk);
  }
  .prose :global(p:has(> img)) { margin-block: 2em; text-align: center; }
  .prose :global(p:has(> img) em) { display: block; margin-top: 0.75rem; font-style: normal; font-size: var(--text-sm); line-height: 1.6; color: var(--muted); }
  .prose :global(blockquote) {
    position: relative;
    margin: 2em 0;
    padding: 1.25rem 1.5rem 1.25rem 3.25rem;
    border: 1px solid var(--accent-line);
    border-radius: var(--radius-card);
    background: var(--accent-soft);
    color: var(--ink);
    font-weight: 600;
  }
  /* 본문 끝의 '함께 읽으면 좋은 글' 상자: 인용과 구분되도록 따옴표 없이 목록형으로 */
  .prose :global(.read-next blockquote) { padding: 1.25rem 1.5rem; font-weight: 500; background: var(--surface); border-color: var(--line-strong); box-shadow: var(--shadow-sm); }
  .prose :global(.read-next blockquote)::before { content: none; }
  .prose :global(.read-next blockquote p) { margin: 0 0 0.625rem; font-weight: 700; }
  .prose :global(.read-next blockquote ul) { margin: 0; padding-left: 0; list-style: none; display: grid; gap: 0.5rem; }
  .prose :global(.read-next blockquote li) { margin: 0; padding-left: 0; line-height: 1.6; }
  .prose :global(.read-next blockquote li)::before { content: none; }
  .prose :global(blockquote)::before {
    content: '“';
    position: absolute;
    left: 1.125rem;
    top: 0.75rem;
    font-size: 2.5rem;
    font-weight: 700;
    line-height: 1;
    color: var(--accent);
  }
  .prose :global(blockquote p:last-child) { margin-bottom: 0; }
  .prose :global(hr) { margin: 2.5em 0; border: 0; border-top: 1px solid var(--line); }
  .prose :global(table) {
    width: 100%;
    margin: 2em 0;
    border-collapse: separate;
    border-spacing: 0;
    border: 1px solid var(--line);
    border-radius: var(--radius-card);
    background: var(--surface);
    box-shadow: var(--shadow-sm);
